  "events":[
    {"event_id":"2030q3:e01","kind":"social_interaction","at":"2030-07-20","event_kind":"career_process_result_checkin","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静的数据方法岗位在结构化面试后没有进入最终录用，高校研究岗则进入最后一轮；她发现自己对前者落选并没有想象中失落，反而更确定非学术方向也曾被认真比较过。","channel":"in_person","evidence":"两条公开流程给出不同结果。"},
    {"event_id":"2030q3:e02","kind":"social_interaction","at":"2030-07-20","event_kind":"career_process_result_checkin","speaker":"chen_lan","listener":"lin_jing","act":"repair","content":"陈岚提醒她不要把一个落选结果倒推成‘自己本来就只适合高校’，流程结果只能说明这一次没有匹配。","channel":"in_person","evidence":"防止事后合理化。"},

    {"event_id":"2030q3:e03","kind":"social_interaction","at":"2030-07-29","event_kind":"independent_research_value_review","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"独立价值审读认为收缩后的结果本身不大，但反例和条件拆分清楚解释了为什么原来的大命题失败，机制叙事仍然成立；读者建议把文章主线放在失效边界而不是方法复杂度。","channel":"in_person","evidence":"Q2价值审读候选给出有条件正面结果。"},
    {"event_id":"2030q3:e04","kind":"social_interaction","at":"2030-07-29","event_kind":"independent_research_value_review","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁同意继续项目，但要求下一版标题、摘要和引言都围绕机制边界重写；如果还用旧的大结果叙事，就算内部证明正确也不适合投稿。","channel":"in_person","evidence":"研究价值与证明正确性分开。"},
    {"event_id":"2030q3:e05","kind":"social_interaction","at":"2030-07-29","event_kind":"independent_research_value_review","speaker":"tang_yu","listener":"shen_yan","act":"make_plan","content":"唐雨决定保留项目并彻底改写叙事，下一阶段再讨论作者贡献和正式投稿，不抢先定刊物。","channel":"in_person","evidence":"形成重写候选。"},

    {"event_id":"2030q3:e06","kind":"social_interaction","at":"2030-08-15","event_kind":"offer_bundle_evaluation","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静拿到区域高校研究岗offer后，把较低住房、相对可控通勤、较高研究自主性和不算高的机会密度放在一起算；她最担心的是评价压力会不会慢慢吃掉自主时间。","channel":"in_person","evidence":"offer由公开高校招聘流程生成。"},
    {"event_id":"2030q3:e07","kind":"social_interaction","at":"2030-08-15","event_kind":"offer_bundle_evaluation","speaker":"chen_lan","listener":"lin_jing","act":"offer_information","content":"陈岚建议她把合同周期、年度评价、教学或服务负担、城市住房和离开后可迁移性都问清楚，再决定研究自主性是不是实际存在。","channel":"in_person","evidence":"通用bundle核验。"},
    {"event_id":"2030q3:e08","kind":"social_interaction","at":"2030-08-15","event_kind":"offer_bundle_evaluation","speaker":"lin_jing","listener":"chen_lan","act":"make_plan","content":"林静暂不立即接受，先等待书面职责和评价结构，并保留拒绝可能。","channel":"in_person","evidence":"形成最终offer检查候选。"},

    {"event_id":"2030q3:e09","kind":"social_interaction","at":"2030-08-23","event_kind":"portable_professional_asset_review","speaker":"song_nan","listener":"zhao_ke","act":"share_experience","content":"宋楠用公开数据和模拟场景完成了三个小案例，分别展示范围澄清、版本变更记录和风险识别；她没有复制任何公司文档或客户背景。","channel":"wechat_private","evidence":"Q1便携资产候选完成材料。"},
    {"event_id":"2030q3:e10","kind":"social_interaction","at":"2030-08-23","event_kind":"portable_professional_asset_review","speaker":"zhao_ke","listener":"song_nan","act":"offer_information","content":"赵珂认为案例已经能证明思考过程，但提醒她不要把模拟场景写得像真实项目业绩；它的价值是展示判断框架，不是替代真实履历。","channel":"wechat_private","evidence":"资产边界审阅。"},

    {"event_id":"2030q3:e11","kind":"social_interaction","at":"2030-09-08","event_kind":"technical_ownership_boundary_check","speaker":"zhou_ye","listener":"xu_hang","act":"share_experience","content":"周野第三年收到更多跨团队交接请求，开始出现‘所有难交接的都找他’的苗头；他担心技术标准所有权又滑回无限收尾。","channel":"wechat_private","evidence":"第三年角色评估显示交接请求增加。"},
    {"event_id":"2030q3:e12","kind":"social_interaction","at":"2030-09-08","event_kind":"technical_ownership_boundary_check","speaker":"xu_hang","listener":"zhou_ye","act":"offer_information","content":"许航建议他把支持拆成标准、模板、培训和例外升级四层：标准能自己解决的就不亲自接，只有例外才进入个人时间。","channel":"wechat_private","evidence":"把个人可靠性转为制度化支持。"},
    {"event_id":"2030q3:e13","kind":"social_interaction","at":"2030-09-08","event_kind":"technical_ownership_boundary_check","speaker":"zhou_ye","listener":"xu_hang","act":"make_plan","content":"周野决定试行一个月：普通交接只提供模板和核验表，真正异常情况再由他介入。","channel":"wechat_private","evidence":"形成工作设计实验候选。"},

    {"event_id":"2030q3:e14","kind":"social_interaction","at":"2030-09-14","event_kind":"public_institution_third_year_checkin","speaker":"he_xin","listener":"sun_jie","act":"share_experience","content":"何欣第三年仍没有强烈离开动机，但开始意识到一旦再过几年，福利连续性、城市熟悉度和同事网络都会让重新选择更贵。","channel":"wechat_private","evidence":"路径依赖来自实际工作年限与城市生活。"},
    {"event_id":"2030q3:e15","kind":"social_interaction","at":"2030-09-14","event_kind":"public_institution_third_year_checkin","speaker":"sun_jie","listener":"he_xin","act":"offer_information","content":"孙洁建议她别因为未来切换会更贵就现在急着跳，先每年固定做一次退出成本核算，让路径依赖保持可见。","channel":"wechat_private","evidence":"不把锁定自动变成离职触发。"},

    {"event_id":"2030q3:e16","kind":"social_interaction","at":"2030-09-21","event_kind":"formal_role_year_one_checkin","speaker":"chen_lan","listener":"wu_cheng","act":"share_experience","content":"陈岚接近一年时确认岗位时间结构总体可持续，收入和学习都够用，但工作身份已经明显从研究者转向组织里的数据运营与判断。","channel":"in_person","evidence":"一年岗位体验。"},
    {"event_id":"2030q3:e17","kind":"social_interaction","at":"2030-09-21","event_kind":"formal_role_year_one_checkin","speaker":"wu_cheng","listener":"chen_lan","act":"check_in","content":"吴澄问她是否把这种身份变化当损失；陈岚说暂时更像交换，她保住了时间边界，也失去了一部分研究自由。","channel":"in_person","evidence":"身份转换被双面记录。"},

    {"event_id":"2030q3:e18","kind":"social_interaction","at":"2030-09-28","event_kind":"old_classmate_identity_call","speaker":"gao_yuan","listener":"luo_cheng","act":"share_experience","content":"高原说自己越来越少用‘数学博士’介绍日常工作，但仍不想完全丢掉那段训练；罗诚则因为工作里继续接触研究材料，博士身份转化得更慢。","channel":"phone","evidence":"不同工作结构造成身份变化差异。"},
    {"event_id":"2030q3:e19","kind":"social_interaction","at":"2030-09-28","event_kind":"old_classmate_identity_call","speaker":"luo_cheng","listener":"gao_yuan","act":"repair","content":"罗诚说两个人不需要把谁离学术更近当成输赢，只是博士训练正在不同岗位里以不同速度被重新编码。","channel":"phone","evidence":"关系中避免比较排名。"}
  ],
