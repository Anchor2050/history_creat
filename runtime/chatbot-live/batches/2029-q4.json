  "events": [
    {"event_id":"2029q4:e01","kind":"social_interaction","at":"2029-10-08","event_kind":"offer_final_check","speaker":"chen_lan","listener":"lin_jing","act":"share_experience","content":"陈岚拿到正式合同后逐条对过响应轮转、岗位范围和试用期安排，确认没有把面试时的边界悄悄改回高频随时响应。","channel":"in_person","evidence":"合同更新提供了最终可检查信息。"},
    {"event_id":"2029q4:e02","kind":"social_interaction","at":"2029-10-08","event_kind":"offer_final_check","speaker":"chen_lan","listener":"lin_jing","act":"make_plan","content":"陈岚决定接受岗位并在11月入职；搬家后仍保留应急现金，不用一次性提高住房标准。","channel":"in_person","evidence":"合同、现金和住房检查通过后形成接受决定。"},

    {"event_id":"2029q4:e03","kind":"social_interaction","at":"2029-10-21","event_kind":"doctoral_completion_closure","speaker":"lin_jing","listener":"shen_yan","act":"share_experience","content":"林静完成答辩或等价程序后拿到一组边界清楚的修改意见，核心论证没有被要求重做；她第一次把博士完成看成真正有限的任务。","channel":"in_person","evidence":"制度事件为bounded revisions。"},
    {"event_id":"2029q4:e04","kind":"social_interaction","at":"2029-10-21","event_kind":"doctoral_completion_closure","speaker":"shen_yan","listener":"lin_jing","act":"offer_information","content":"沈雁让她先把规定修改逐项关掉，再谈毕业后的城市和岗位，不要在最后一步重新同时开三条战线。","channel":"in_person","evidence":"导师保持完成优先级。"},
    {"event_id":"2029q4:e05","kind":"social_interaction","at":"2029-10-21","event_kind":"doctoral_completion_closure","speaker":"lin_jing","listener":"shen_yan","act":"make_plan","content":"林静决定把职业搜索推迟到修改闭环后，先保住一个不被求职信息打碎的完成窗口。","channel":"in_person","evidence":"形成最终修改候选。"},

    {"event_id":"2029q4:e06","kind":"social_interaction","at":"2029-11-02","event_kind":"internal_method_asset_field_test","speaker":"xu_hang","listener":"gu_wei","act":"share_experience","content":"验证规范试用一个月后，一个任务可以在许航不介入的情况下按规范完成，另一个任务仍频繁来问‘什么算失败’和‘输出差多少要停’。","channel":"in_person","evidence":"Q3要求的真实使用测试给出混合结果。"},
    {"event_id":"2029q4:e07","kind":"social_interaction","at":"2029-11-02","event_kind":"internal_method_asset_field_test","speaker":"gu_wei","listener":"xu_hang","act":"offer_information","content":"顾维认为这说明规范已经有迁移价值，但判停规则写得还像许航脑中的隐性经验；下一版要把阈值、例外和需要人工判断的地方明确标出来。","channel":"in_person","evidence":"资产未被直接判定成熟。"},

    {"event_id":"2029q4:e08","kind":"social_interaction","at":"2029-11-12","event_kind":"independent_internal_read","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"独立逻辑审读没有否掉主命题，但指出一个关键引理在边界情形里偷偷用了更强条件；唐雨把这看成真实证明缺口，而不是措辞问题。","channel":"in_person","evidence":"独立审读产生外部于作者自评的负面检查。"},
    {"event_id":"2029q4:e09","kind":"social_interaction","at":"2029-11-12","event_kind":"independent_internal_read","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁要求她先尝试在原条件下补引理；如果补不上，就收缩命题或明确增加条件，不能靠模拟看起来没问题就跨过去。","channel":"in_person","evidence":"研究线再次进入可失败分支。"},
    {"event_id":"2029q4:e10","kind":"social_interaction","at":"2029-11-12","event_kind":"independent_internal_read","speaker":"tang_yu","listener":"shen_yan","act":"make_plan","content":"唐雨暂停投稿准备，把年底任务改成补引理或构造反例，内部草稿状态回到‘需实质修改’。","channel":"in_person","evidence":"独立审读阻止过早投稿。"},

    {"event_id":"2029q4:e11","kind":"social_interaction","at":"2029-11-30","event_kind":"same_city_weak_tie_meetup","speaker":"zhou_ye","listener":"he_xin","act":"share_experience","content":"周野说第二年评估没有升职，但他开始真正拥有一套技术交接标准；何欣则说学习时间只能部分守住，但已经足以让她不把稳定生活理解成完全停滞。","channel":"in_person","evidence":"第二年工作评估与实验结果。"},
    {"event_id":"2029q4:e12","kind":"social_interaction","at":"2029-11-30","event_kind":"same_city_weak_tie_meetup","speaker":"he_xin","listener":"zhou_ye","act":"small_talk","content":"两人更多讨论冬天通勤、房租续约和周末回不回家，没有形成新的资源候选。","channel":"in_person","evidence":"维持低频弱联系。"},

    {"event_id":"2029q4:e13","kind":"social_interaction","at":"2029-12-08","event_kind":"cross_city_career_checkin","speaker":"chen_lan","listener":"song_nan","act":"share_experience","content":"陈岚入职一个月后说，正式岗位并没有突然让生活完美，但并行任务和临时响应确实比上一份被她拒掉的offer可控；她至少没有立刻回到无限接活的状态。","channel":"video_call","evidence":"新岗位一个月实际体验。"},
    {"event_id":"2029q4:e14","kind":"social_interaction","at":"2029-12-08","event_kind":"cross_city_career_checkin","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠说自己第二年愿意继续留在医药统计，但也开始更在意哪些能力是公司之外仍可迁移的，不想把成长只理解成组织内熟练度。","channel":"video_call","evidence":"行业第二年经验。"},

    {"event_id":"2029q4:e15","kind":"social_interaction","at":"2029-12-14","event_kind":"first_year_role_review","speaker":"gao_yuan","listener":"zhou_ye","act":"share_experience","content":"高原一年后仍选择留下：低机会密度是真的，家庭距离、住房和稳定时间的收益也是真的；他没有出现强烈后悔，也没有再把这份工作理想化。","channel":"phone","evidence":"第一年完整体验。"},
    {"event_id":"2029q4:e16","kind":"social_interaction","at":"2029-12-14","event_kind":"first_year_role_review","speaker":"zhou_ye","listener":"gao_yuan","act":"check_in","content":"周野问他博士时期最舍不得的是什么，高原说是长时间想一个问题的自由；现在只能靠很小的阅读时间保持联系。","channel":"phone","evidence":"职业身份变化。"},

    {"event_id":"2029q4:e17","kind":"actor_state_interaction","at":"2029-12-18","event_kind":"project_manager_boundary_scene","speaker":"zhao_ke","listener":"self_record","act":"share_experience","content":"赵珂年底复盘发现，主动拒绝没有预算、责任人和范围的‘先试试看’后，项目数量少了一点，但返工和隐性加班也少了；代价是他必须更早对合作方说不。","channel":"private_record","evidence":"延续其项目经理边界线。"},

    {"event_id":"2029q4:e18","kind":"social_interaction","at":"2029-12-27","event_kind":"year_end_group_call","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静只说自己已经完成正式程序、正在关最后修改，没有在群里提前宣布下一份工作计划；陈岚则公开说自己换到省会正式岗位一个月。","channel":"video_call","evidence":"两人只公开各自选择披露的当前状态。"},
    {"event_id":"2029q4:e19","kind":"social_interaction","at":"2029-12-27","event_kind":"year_end_group_call","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"唐雨告诉许航独立读稿发现了一个真实证明缺口，验证线暂时不用加算例；许航说等理论分支稳定后再决定是否需要新的检查。","channel":"video_call","evidence":"合作随任务阶段自然降频。"},
    {"event_id":"2029q4:e20","kind":"social_interaction","at":"2029-12-27","event_kind":"year_end_group_call","speaker":"luo_cheng","listener":"gao_yuan","act":"small_talk","content":"罗诚和高原更多聊春节回家、通勤和工作节奏，没有把年末通话做成职业排名。","channel":"video_call","evidence":"普通关系维持。"}
