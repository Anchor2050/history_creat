  "events": [
    {"event_id":"2031q3:e01","kind":"social_interaction","at":"2031-07-18","event_kind":"service_boundary_experiment_review","speaker":"lin_jing","listener":"shen_yan","act":"share_experience","content":"林静第二学期减少了两类可替代的额外服务后，每周至少有一块连续研究时间比上学期稳定；代价是她需要更早说明哪些事务自己不接，并承担少量‘不够积极’的主观压力。","channel":"video_call","evidence":"Q2服务边界实验产生可观察结果。"},
    {"event_id":"2031q3:e02","kind":"social_interaction","at":"2031-07-18","event_kind":"service_boundary_experiment_review","speaker":"shen_yan","listener":"lin_jing","act":"offer_information","content":"沈雁提醒她只要正式职责没有受损，就把这当作工作设计而不是性格评价；真正需要继续观察的是年度评价会不会惩罚这种边界。","channel":"video_call","evidence":"短期实验成功不等于制度长期允许。"},

    {"event_id":"2031q3:e03","kind":"social_interaction","at":"2031-07-27","event_kind":"manuscript_final_assembly","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"完整项目贡献记录已经核对完，许航负责的验证与反例部分保留在主文；全体列名贡献者完成内部确认，长历史账本只记录状态，不复制其他人的身份与顺序。","channel":"in_person","evidence":"作者资格由完整项目记录确认，避免在长历史层虚构未建模人物。"},
    {"event_id":"2031q3:e04","kind":"social_interaction","at":"2031-07-27","event_kind":"manuscript_final_assembly","speaker":"xu_hang","listener":"tang_yu","act":"make_plan","content":"许航完成验证段落最终版本和可复查材料，确认自己愿意对这部分的设计、限制和结论负责；两人同意投稿后即使审稿要求删减，也继续按实际最终贡献重新核对署名。","channel":"in_person","evidence":"作者责任在投稿前完成。"},

    {"event_id":"2031q3:e05","kind":"social_interaction","at":"2031-08-06","event_kind":"home_purchase_consideration","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠的收入和几年积累让她在工程先验下已经能承担医药产业城市的首付和最低缓冲，但一旦买房，未来跨城选择和回家距离问题都会被放大。","channel":"video_call","evidence":"2031财务检查通过但迁移成本高。"},
    {"event_id":"2031q3:e06","kind":"social_interaction","at":"2031-08-06","event_kind":"home_purchase_consideration","speaker":"chen_lan","listener":"song_nan","act":"offer_information","content":"陈岚问她现在是否愿意把‘我暂时愿意留’升级成‘我愿意为这座城市承担长期退出成本’；宋楠说还没有，她现在更想保留便携案例真正带来的可逆性。","channel":"video_call","evidence":"当前留任与长期城市承诺被分开。"},
    {"event_id":"2031q3:e07","kind":"social_interaction","at":"2031-08-06","event_kind":"home_purchase_consideration","speaker":"song_nan","listener":"chen_lan","act":"make_plan","content":"宋楠决定2031不购房，继续租住，把现金缓冲和职业迁移能力保留下来；下一次只在长期城市承诺更清楚时重新评估。","channel":"video_call","evidence":"财务可行但城市承诺不通过。"},

    {"event_id":"2031q3:e08","kind":"social_interaction","at":"2031-08-22","event_kind":"submission_target_and_claim_check","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"唐雨把候选投稿目标、摘要和主结论逐条对齐，最终版本只声称边界条件下的最小机制结果与失效反例，不再暗示更一般的结论。","channel":"in_person","evidence":"正式投稿目标由当前结果规模与叙事匹配，不预写期刊结果。"},
    {"event_id":"2031q3:e09","kind":"social_interaction","at":"2031-08-22","event_kind":"submission_target_and_claim_check","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁确认完整作者批准和文件核对都已具备，允许进入正式投稿；他提醒投稿本身只结束内部准备阶段，外部评价可能再次否定当前叙事。","channel":"in_person","evidence":"投稿权限来自完整内部检查。"},
    {"event_id":"2031q3:e10","kind":"social_interaction","at":"2031-09-12","event_kind":"submission_target_and_claim_check","speaker":"tang_yu","listener":"xu_hang","act":"check_in","content":"投稿系统确认收稿后，唐雨只告诉许航状态已经变成under review；两人没有把提交动作当成研究结果已经被认可。","channel":"wechat_private","evidence":"投稿事实由portal acknowledgment生成。"},

    {"event_id":"2031q3:e11","kind":"social_interaction","at":"2031-09-20","event_kind":"formal_role_year_two_checkin","speaker":"chen_lan","listener":"wu_cheng","act":"share_experience","content":"陈岚第二年评估仍显示岗位时间结构可持续，她也越来越能影响数据流程设计；但研究自由度没有回升，她已经不再把它当成暂时现象，而是这份工作的稳定交换条件。","channel":"in_person","evidence":"两年工作证据支持结构性身份交换。"},
    {"event_id":"2031q3:e12","kind":"social_interaction","at":"2031-09-20","event_kind":"formal_role_year_two_checkin","speaker":"wu_cheng","listener":"chen_lan","act":"repair","content":"吴澄说真正需要防的是以后把这份交换包装成‘我本来就不想研究’；陈岚决定继续承认自己既获得了边界，也失去了一部分自由。","channel":"in_person","evidence":"防止事后单向合理化。"},

    {"event_id":"2031q3:e13","kind":"social_interaction","at":"2031-09-10","event_kind":"growth_density_reassessment","speaker":"gao_yuan","listener":"luo_cheng","act":"share_experience","content":"高原尝试在现岗位内部寻找更复杂的专项工作，但短期没有出现明显扩展职责的机会；他仍不准备马上离开，只把2032职业再评价的优先级提高。","channel":"phone","evidence":"Q1成长密度候选未找到足够内部增量。"},
    {"event_id":"2031q3:e14","kind":"social_interaction","at":"2031-09-10","event_kind":"growth_density_reassessment","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚说自己这边内容适配在提高，但平台上限仍在；两人约定2032各自重新算一次‘留下来的收益’和‘重新进入市场的成本’，不共享具体未公开岗位。","channel":"phone","evidence":"形成2032再评价候选。"},

    {"event_id":"2031q3:e15","kind":"social_interaction","at":"2031-09-26","event_kind":"boundary_system_peer_exchange","speaker":"zhao_ke","listener":"sun_jie","act":"share_experience","content":"赵珂说项目入口规则制度化后，团队救火减少，但真正紧急的例外更需要有人承担判断责任；孙洁说队列规则也有同样问题，规则减少常态插队，却让例外判断更显眼。","channel":"in_person","evidence":"两条独立边界线形成同行横向比较。"},
    {"event_id":"2031q3:e16","kind":"social_interaction","at":"2031-09-26","event_kind":"boundary_system_peer_exchange","speaker":"sun_jie","listener":"zhao_ke","act":"offer_information","content":"两人都认为下一步不是把规则做得更硬，而是把什么算例外、谁有权确认例外写得更清楚；没有形成共同项目。","channel":"in_person","evidence":"横向经验交换不生成资源。"},

    {"event_id":"2031q3:e17","kind":"actor_state_interaction","at":"2031-08-29","event_kind":"verification_mentor_personal_scene","speaker":"gu_wei","listener":"self_record","act":"share_experience","content":"顾维发现自己近几年越来越常被年轻人拿‘验证规范’来问是否合格，他开始担心大家把检查表当成替代判断的答案；他准备以后要求提问者同时说明为什么这个问题值得这些检查。","channel":"private_record","evidence":"验证方法制度化后出现导师层面的过度程序化担忧。"}
