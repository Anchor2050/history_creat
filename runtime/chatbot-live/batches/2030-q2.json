  "events":[
    {"event_id":"2030q2:e01","kind":"social_interaction","at":"2030-04-20","event_kind":"career_bundle_comparison","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静第一轮筛选后留下两个方向：一个高校研究岗位更接近学术训练但时间与评价压力更高，一个数据方法岗位时间结构更清楚但研究自主性较弱；她没有因为博士背景就先删掉后者。","channel":"in_person","evidence":"两条机会均来自公开筛选结果，尚未形成offer。"},
    {"event_id":"2030q2:e02","kind":"social_interaction","at":"2030-04-20","event_kind":"career_bundle_comparison","speaker":"chen_lan","listener":"lin_jing","act":"offer_information","content":"陈岚建议她面试时分别验证评价周期、并行任务、城市住房和离开后的可迁移性，先收信息再决定哪个身份更像自己。","channel":"in_person","evidence":"通用bundle核验。"},
    {"event_id":"2030q2:e03","kind":"social_interaction","at":"2030-04-20","event_kind":"career_bundle_comparison","speaker":"lin_jing","listener":"chen_lan","act":"make_plan","content":"林静决定两条线都继续到获得足够岗位信息为止，不提前用‘学术/非学术’标签做最终选择。","channel":"in_person","evidence":"并行信息收集候选。"},

    {"event_id":"2030q2:e04","kind":"social_interaction","at":"2030-04-28","event_kind":"research_statement_revision","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"唐雨把主命题收缩到能避开边界反例的最小版本后，证明主线重新闭合，但适用范围明显比两年前设想的小。","channel":"in_person","evidence":"Q1负面结果后按要求缩小命题。"},
    {"event_id":"2030q2:e05","kind":"social_interaction","at":"2030-04-28","event_kind":"research_statement_revision","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁没有因为命题变小就否定项目，只问这个最小结果是否揭示了一个可复用机制，以及反例是否能说明为什么更大命题失败；如果两者都没有，项目可能应该结束。","channel":"in_person","evidence":"研究价值检查，不保证成稿。"},
    {"event_id":"2030q2:e06","kind":"social_interaction","at":"2030-04-28","event_kind":"research_statement_revision","speaker":"tang_yu","listener":"shen_yan","act":"make_plan","content":"唐雨决定把下一轮内部读稿重点从‘证明有没有漏洞’改成‘结果虽小但机制是否值得形成文章’，接受项目可能在这里停止。","channel":"in_person","evidence":"形成价值审读候选。"},

    {"event_id":"2030q2:e07","kind":"social_interaction","at":"2030-05-04","event_kind":"housing_and_career_checkin","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠续租前重新算了一遍高房租、通勤和学习密度，最后仍决定在医药产业城市再留一年；她把房租看成当前职业学习密度的一部分成本，而不是永久定居承诺。","channel":"video_call","evidence":"租赁窗口与第三年职业状态。"},
    {"event_id":"2030q2:e08","kind":"social_interaction","at":"2030-05-04","event_kind":"housing_and_career_checkin","speaker":"chen_lan","listener":"song_nan","act":"share_experience","content":"陈岚说自己在省会的新岗位住房压力低一些，但职业学习密度也不同；两个人第一次更具体地意识到城市成本和职业密度是绑在一起的。","channel":"video_call","evidence":"两人真实城市bundle对照。"},

    {"event_id":"2030q2:e09","kind":"social_interaction","at":"2030-05-17","event_kind":"same_city_path_checkin","speaker":"zhou_ye","listener":"he_xin","act":"check_in","content":"周野问何欣第三年还会不会觉得稳定等于停滞；何欣说学习时间虽不完美但能维持，所以她目前没有强烈离开动机。","channel":"in_person","evidence":"延续两人低频同城弱联系。"},
    {"event_id":"2030q2:e10","kind":"social_interaction","at":"2030-05-17","event_kind":"same_city_path_checkin","speaker":"he_xin","listener":"zhou_ye","act":"check_in","content":"何欣反问周野会不会因为技术责任变多就长期留在国企；周野说现在最多能确认下一阶段愿意留，仍不愿用第三年状态替十年后做决定。","channel":"in_person","evidence":"路径依赖被承认但不写成命运。"},

    {"event_id":"2030q2:e11","kind":"social_interaction","at":"2030-06-08","event_kind":"second_year_role_review","speaker":"luo_cheng","listener":"sun_jie","act":"share_experience","content":"罗诚第二年开始接触更多研究内容后，确认自己更愿意留在研究支持线；流程工作仍多，但已经能看见自己对研究材料的判断产生实际价值。","channel":"wechat_private","evidence":"由第二年角色评估生成。"},
    {"event_id":"2030q2:e12","kind":"social_interaction","at":"2030-06-08","event_kind":"second_year_role_review","speaker":"sun_jie","listener":"luo_cheng","act":"check_in","content":"孙洁只问这种专业内容是否稳定存在，提醒他不要因为半年变好就假定以后一直如此；罗诚决定再看一个完整年度。","channel":"wechat_private","evidence":"职业留任继续通过时间验证。"},

    {"event_id":"2030q2:e13","kind":"social_interaction","at":"2030-06-15","event_kind":"internal_method_asset_use_review","speaker":"xu_hang","listener":"gu_wei","act":"share_experience","content":"组内可选验证标准继续被两项任务使用，许航本人只在少数边界判断上介入；他第一次能把这套东西看成不完全依赖自己的工作资产。","channel":"in_person","evidence":"内部采用后的持续使用。"},
    {"event_id":"2030q2:e14","kind":"social_interaction","at":"2030-06-15","event_kind":"internal_method_asset_use_review","speaker":"gu_wei","listener":"xu_hang","act":"offer_information","content":"顾维建议下一步先别急着对外发表规范，而是记录它在哪些任务上不好用；适用边界本身可能比一套看似通用的清单更有价值。","channel":"in_person","evidence":"继续做负面适用性记录。"},

    {"event_id":"2030q2:e15","kind":"social_interaction","at":"2030-06-21","event_kind":"old_classmate_life_structure_call","speaker":"gao_yuan","listener":"zhou_ye","act":"share_experience","content":"高原说独立租住后日常边界更清楚，离家近的好处仍在，但他没有因为父母住得近就出现现实照护负担；现在最大的长期疑问仍是成长空间。","channel":"phone","evidence":"仅陈述当前没有已发生的照护事件，不从年龄推导危机。"},
    {"event_id":"2030q2:e16","kind":"social_interaction","at":"2030-06-21","event_kind":"old_classmate_life_structure_call","speaker":"zhou_ye","listener":"gao_yuan","act":"share_experience","content":"周野说省会工作第三年带来的锁定更多是熟悉组织和技术责任，而不是房子；他仍然租住，也没有因为工作稳定就买房。","channel":"phone","evidence":"城市锁定来自工作年限与组织知识。"},

    {"event_id":"2030q2:e17","kind":"social_interaction","at":"2030-06-27","event_kind":"work_boundary_peer_exchange","speaker":"zhao_ke","listener":"sun_jie","act":"share_experience","content":"赵珂和孙洁比较后发现，两个人这几年都在把‘随时可以找我’改成明确入口：一个是项目范围和责任人，一个是正式事务队列。","channel":"in_person","evidence":"两条个人边界线首次直接交换。"},
    {"event_id":"2030q2:e18","kind":"social_interaction","at":"2030-06-27","event_kind":"work_boundary_peer_exchange","speaker":"sun_jie","listener":"zhao_ke","act":"repair","content":"孙洁说边界最难的部分是接受有人会觉得你没以前好说话；赵珂说项目里也是一样，但长期返工减少后，这个成本变得更容易承担。","channel":"in_person","evidence":"功能角色之间形成真实同行经验，不产生资源转移。"}
