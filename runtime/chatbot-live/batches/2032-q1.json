  "events": [
    {"event_id":"2032q1:e01","kind":"social_interaction","at":"2032-01-10","event_kind":"structured_midcareer_reassessment","speaker":"gao_yuan","listener":"luo_cheng","act":"share_experience","content":"高原把三年工作的收益和成本分别列出来：低住房、近家庭、稳定时间依然很值钱，但新问题和角色扩展几乎没有增加；他决定先看市场，不先写辞职理由。","channel":"phone","evidence":"2031再评价候选进入正式比较。"},
    {"event_id":"2032q1:e02","kind":"social_interaction","at":"2032-01-10","event_kind":"structured_midcareer_reassessment","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚的研究支持内容越来越适配，但平台层级、城市机会和岗位晋升空间仍有限；他也决定先做市场校准，再看是否值得把适配内容换成更大平台。","channel":"phone","evidence":"三年角色收益与平台上限同时存在。"},

    {"event_id":"2032q1:e03","kind":"social_interaction","at":"2032-02-12","event_kind":"public_market_calibration","speaker":"gao_yuan","listener":"lin_jing","act":"share_experience","content":"高原看了公开岗位后发现，成长密度更高的选择通常伴随更远城市、更高住房或更低安全感；市场没有给他一个明显占优的新答案。","channel":"video_call","evidence":"公开市场扫描结果。"},
    {"event_id":"2032q1:e04","kind":"social_interaction","at":"2032-02-12","event_kind":"public_market_calibration","speaker":"lin_jing","listener":"gao_yuan","act":"offer_information","content":"林静建议他别把‘没有明显更优选项’理解成当前岗位就是最优，只把它记录成这一次再进入市场的机会成本比想象中高。","channel":"video_call","evidence":"防止市场扫描被解释成终身留任证明。"},

    {"event_id":"2032q1:e05","kind":"social_interaction","at":"2032-02-14","event_kind":"public_market_calibration","speaker":"luo_cheng","listener":"lin_jing","act":"share_experience","content":"罗诚发现公开市场上确实有更大平台的研究支持或数据协调岗位，但大多需要搬城，有些工作内容反而比当前岗位更远离研究判断。","channel":"video_call","evidence":"市场存在但bundle和内容匹配不占优。"},
    {"event_id":"2032q1:e06","kind":"social_interaction","at":"2032-02-14","event_kind":"public_market_calibration","speaker":"lin_jing","listener":"luo_cheng","act":"offer_information","content":"林静让他把‘平台更大’和‘工作更像自己想做的’分开；罗诚决定只对内容和平台都显著改善的岗位打开申请。","channel":"video_call","evidence":"形成选择性申请门槛。"},

    {"event_id":"2032q1:e07","kind":"social_interaction","at":"2032-02-22","event_kind":"external_market_calibration","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠用便携案例去对照公开岗位后发现，外部市场确实能读懂她的范围、版本和风险判断，但真正有区分度的仍是医药领域交付经验，而不是生存分析方法名。","channel":"video_call","evidence":"便携案例首次用于外部岗位可读性校准。"},
    {"event_id":"2032q1:e08","kind":"social_interaction","at":"2032-02-22","event_kind":"external_market_calibration","speaker":"chen_lan","listener":"song_nan","act":"offer_information","content":"陈岚说这说明她的专业身份已经可以离开公司名字存在，但下一步要比较的是外部岗位能否同时改善学习、城市或家庭距离，不能为了证明可迁移就随便投。","channel":"video_call","evidence":"市场校准不自动触发求职。"},

    {"event_id":"2032q1:e09","kind":"social_interaction","at":"2032-03-16","event_kind":"major_revision_response_planning","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"外审给出major revision，最尖锐的问题仍集中在边界：反例能证明什么、理论必要性究竟到哪一步、验证设计是不是只适用于当前问题。","channel":"video_call","evidence":"真实外审第一次重新检验内部叙事。"},
    {"event_id":"2032q1:e10","kind":"social_interaction","at":"2032-03-16","event_kind":"major_revision_response_planning","speaker":"xu_hang","listener":"tang_yu","act":"make_plan","content":"许航决定补写验证框架为何足以支持当前边界判断，同时主动列出它不支持的更广结论；两人不准备为了回应审稿而重新放大命题。","channel":"video_call","evidence":"验证部分回应范围保持收缩。"},

    {"event_id":"2032q1:e11","kind":"social_interaction","at":"2032-03-22","event_kind":"major_revision_scope_review","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"唐雨把审稿意见分成可通过解释解决、需要补一个局部证明、以及不能诚实解决的三类；第三类准备直接承认限制，不用新假设掩盖。","channel":"in_person","evidence":"外部评价继续强化诚实边界。"},
    {"event_id":"2032q1:e12","kind":"social_interaction","at":"2032-03-22","event_kind":"major_revision_scope_review","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁认为major revision不是奖励也不是失败，关键是修后版本是否仍然是一篇完整的小结果；如果为了回应所有意见把问题重新做大，宁愿缩短回应。","channel":"in_person","evidence":"修稿仍受机制尺度约束。"},

    {"event_id":"2032q1:e13","kind":"social_interaction","at":"2032-03-28","event_kind":"university_role_year_two_boundary_check","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静第二年开头仍能保住固定研究块，但已经看到新一轮服务请求重新增加；她没有立刻拒绝全部，而是继续区分正式职责和可替代额外工作。","channel":"video_call","evidence":"第一年边界并非永久完成。"},
    {"event_id":"2032q1:e14","kind":"social_interaction","at":"2032-03-28","event_kind":"university_role_year_two_boundary_check","speaker":"chen_lan","listener":"lin_jing","act":"offer_information","content":"陈岚说真正的锁定不是工作变多，而是几年后你开始觉得这些额外工作已经是‘自己应该做的’；林静决定继续记录哪些服务是角色变化，哪些只是习惯性接活。","channel":"video_call","evidence":"第二年路径依赖监测。"}
