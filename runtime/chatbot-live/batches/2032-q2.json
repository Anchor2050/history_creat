  "events": [
    {"event_id":"2032q2:e01","kind":"social_interaction","at":"2032-04-10","event_kind":"major_revision_validation_rewrite","speaker":"xu_hang","listener":"tang_yu","act":"share_experience","content":"许航把验证部分拆成‘支持当前反例可靠性’、‘支持边界判断’和‘不能支持理论必要性’三层，主动删掉容易让审稿人误读成普适方法的表述。","channel":"video_call","evidence":"major revision要求明确验证适用范围。"},
    {"event_id":"2032q2:e02","kind":"social_interaction","at":"2032-04-10","event_kind":"major_revision_validation_rewrite","speaker":"tang_yu","listener":"xu_hang","act":"repair","content":"唐雨据此把回应信里关于验证的措辞改成辅助边界判断，不再让计算部分承担理论上不能承担的证明责任。","channel":"video_call","evidence":"外审推动验证贡献更精确，而非更大。"},

    {"event_id":"2032q2:e03","kind":"social_interaction","at":"2032-04-26","event_kind":"major_revision_local_proof_review","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"major revision要求补的局部证明可以在现有缩小命题下闭合，但如果把结论扩到审稿人顺手提出的更一般情形，原来的反例问题会重新出现。","channel":"in_person","evidence":"修复局部缺口可行，扩大命题不可诚实。"},
    {"event_id":"2032q2:e04","kind":"social_interaction","at":"2032-04-26","event_kind":"major_revision_local_proof_review","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁建议直接说明更一般情形仍开放，把修稿范围锁在现有结论；回应审稿意见不意味着必须解决审稿人提出的所有新问题。","channel":"in_person","evidence":"保持结果尺度。"},

    {"event_id":"2032q2:e05","kind":"social_interaction","at":"2032-04-20","event_kind":"selective_application_decision","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚遇到一个省会研究运营与数据协调公开岗位，工作内容和平台都比当前岗位有明显增量，虽然需要搬城；它第一次同时跨过他年初设的两个门槛。","channel":"phone","evidence":"公开岗位匹配content+platform threshold。"},
    {"event_id":"2032q2:e06","kind":"social_interaction","at":"2032-04-20","event_kind":"selective_application_decision","speaker":"gao_yuan","listener":"luo_cheng","act":"offer_information","content":"高原只提醒他把搬家和失去当前研究内容连续性也算进去，没有因为自己留在家乡就劝罗诚不动。","channel":"phone","evidence":"同学关系保持决策边界。"},
    {"event_id":"2032q2:e07","kind":"social_interaction","at":"2032-04-20","event_kind":"selective_application_decision","speaker":"luo_cheng","listener":"gao_yuan","act":"make_plan","content":"罗诚决定提交一次公开申请，把它当成真实市场检验；在有结果前继续当前工作，不提前搬家或辞职。","channel":"phone","evidence":"申请由选择性门槛触发。"},

    {"event_id":"2032q2:e08","kind":"social_interaction","at":"2032-05-07","event_kind":"selective_application_decision","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠找到一个省会健康数据统计岗位，工资低于当前医药产业城市，但家庭距离明显缩短，工作仍包含真实交付和统计判断；它跨过了她‘至少改善一个重要维度且不丢核心能力’的门槛。","channel":"video_call","evidence":"公开岗位同时改善家庭距离并保留核心工作内容。"},
    {"event_id":"2032q2:e09","kind":"social_interaction","at":"2032-05-07","event_kind":"selective_application_decision","speaker":"chen_lan","listener":"song_nan","act":"offer_information","content":"陈岚建议她先申请拿真实流程反馈，不要因为工资降低就提前否掉，也不要因为离家近就提前美化；是否值得换要等职责、团队和bundle信息都出来。","channel":"video_call","evidence":"申请不等于偏好完成。"},
    {"event_id":"2032q2:e10","kind":"social_interaction","at":"2032-05-07","event_kind":"selective_application_decision","speaker":"song_nan","listener":"chen_lan","act":"make_plan","content":"宋楠决定投递一份申请，并使用便携案例解释工作方式；不带任何当前公司的内部材料。","channel":"video_call","evidence":"便携案例第一次进入真实外部申请。"},

    {"event_id":"2032q2:e11","kind":"social_interaction","at":"2032-05-14","event_kind":"market_threshold_no_application","speaker":"gao_yuan","listener":"lin_jing","act":"share_experience","content":"高原这一轮公开岗位里没有一个同时跨过成长改善和生活bundle门槛，他决定不为了证明自己‘敢变化’而投一个明显不合适的岗位。","channel":"video_call","evidence":"选择性市场门槛没有被任何opening满足。"},
    {"event_id":"2032q2:e12","kind":"social_interaction","at":"2032-05-14","event_kind":"market_threshold_no_application","speaker":"lin_jing","listener":"gao_yuan","act":"repair","content":"林静说再评价得到‘现在没有值得动的选项’也是结果，只要他以后继续更新市场，而不是把这一轮空缺解释成永远没有选项。","channel":"video_call","evidence":"无申请被记录为市场结果而非恐惧。"},

    {"event_id":"2032q2:e13","kind":"social_interaction","at":"2032-06-06","event_kind":"second_year_service_boundary_check","speaker":"lin_jing","listener":"shen_yan","act":"share_experience","content":"第二年服务请求比第一年更多，但林静用上一年的记录能更快判断哪些属于正式职责、哪些只是惯性找她；固定研究块仍能保住大部分。","channel":"video_call","evidence":"边界形成组织记忆，而非一次性拒绝。"},
