  "events": [
    {"event_id":"2031q4:e01","kind":"social_interaction","at":"2031-11-10","event_kind":"university_role_year_one_checkin","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静第一年评估没有因为减少部分额外服务受到正式惩罚，研究块也比上学期稳定；但年度评价让她更清楚这份工作会长期要求可见产出，研究自主并不等于没有制度压力。","channel":"video_call","evidence":"年度评估给出服务边界结果。"},
    {"event_id":"2031q4:e02","kind":"social_interaction","at":"2031-11-10","event_kind":"university_role_year_one_checkin","speaker":"chen_lan","listener":"lin_jing","act":"repair","content":"陈岚说这至少证明第一年的边界实验可行，但不要把一次未受罚当成永久制度保障；林静决定继续按年度而非按想象评价岗位。","channel":"video_call","evidence":"长期制度效果仍开放。"},

    {"event_id":"2031q4:e03","kind":"social_interaction","at":"2031-11-18","event_kind":"same_city_housing_followup","speaker":"zhou_ye","listener":"he_xin","act":"check_in","content":"周野和何欣偶尔见面时才知道两个人今年都认真算过买房，但原因完全不同地继续租着：周野不愿锁迁移，何欣是现金条件没到。","channel":"in_person","evidence":"双方主动披露各自结果；不形成联合住房决策。"},
    {"event_id":"2031q4:e04","kind":"social_interaction","at":"2031-11-18","event_kind":"same_city_housing_followup","speaker":"he_xin","listener":"zhou_ye","act":"share_experience","content":"何欣说知道自己暂时买不起反而让她更认真看租房状态能不能长期舒适；周野说自己买得起一点却不想买，也让他确认‘可选’和‘应该选’之间有差别。","channel":"in_person","evidence":"住房结果没有被社会比较排序。"},

    {"event_id":"2031q4:e05","kind":"social_interaction","at":"2031-12-03","event_kind":"industry_year_four_review","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠第四年评估显示工作范围稳定、表现正常，但新增学习速度开始比前两年慢；她第一次把‘当前岗位还值不值得再待两年’写成2032正式再评价问题。","channel":"video_call","evidence":"学习边际下降由年度评估产生，不自动触发求职。"},
    {"event_id":"2031q4:e06","kind":"social_interaction","at":"2031-12-03","event_kind":"industry_year_four_review","speaker":"chen_lan","listener":"song_nan","act":"offer_information","content":"陈岚建议她明年先用便携案例去看外部市场到底认可什么，再决定是否投递；市场校准可以先于离职行动。","channel":"video_call","evidence":"形成2032市场校准候选，不是跳槽。"},

    {"event_id":"2031q4:e07","kind":"social_interaction","at":"2031-12-16","event_kind":"manuscript_waiting_checkin","speaker":"tang_yu","listener":"xu_hang","act":"check_in","content":"稿件仍在审稿，没有决定。唐雨说自己现在最难适应的是没有更多内部修补动作可做；许航提醒她继续改一个已经送出的版本只会制造另一条历史。","channel":"wechat_private","evidence":"外部评价阶段的等待状态。"},
    {"event_id":"2031q4:e08","kind":"social_interaction","at":"2031-12-16","event_kind":"manuscript_waiting_checkin","speaker":"xu_hang","listener":"tang_yu","act":"small_talk","content":"两人最后只聊了年底各自休几天，没有把等待强行转成新的研究任务。","channel":"wechat_private","evidence":"普通生活互动。"},

    {"event_id":"2031q4:e09","kind":"social_interaction","at":"2031-12-09","event_kind":"career_reassessment_preparation","speaker":"gao_yuan","listener":"luo_cheng","act":"share_experience","content":"高原把2032再评价拆成三个问题：现在岗位给他的时间和家庭距离值多少、成长密度不足付出了什么、重新进入其他市场会损失什么。","channel":"phone","evidence":"三年真实工作后形成再评价框架。"},
    {"event_id":"2031q4:e10","kind":"social_interaction","at":"2031-12-09","event_kind":"career_reassessment_preparation","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚也准备同样做一次，但他的重点是研究内容增长能否抵消平台层级限制；两人仍只交换框架，不交换具体岗位线索。","channel":"phone","evidence":"2032独立再评价准备。"},

    {"event_id":"2031q4:e11","kind":"social_interaction","at":"2031-10-24","event_kind":"mentor_peer_boundary_exchange","speaker":"wu_cheng","listener":"shen_yan","act":"share_experience","content":"吴澄说自己减少临时指导后，团队提问质量提高了一些，但也担心年轻成员把‘别打扰导师’理解得太重；沈雁说他在研究指导里也会遇到相反风险：边界太软会替学生做问题，边界太硬又会错过真正需要判断的节点。","channel":"in_person","evidence":"两名导师首次以同行身份讨论边界的双向风险。"},
    {"event_id":"2031q4:e12","kind":"social_interaction","at":"2031-10-24","event_kind":"mentor_peer_boundary_exchange","speaker":"shen_yan","listener":"wu_cheng","act":"offer_information","content":"两人最后都倾向把边界写成‘什么问题值得同步讨论’而不是简单减少次数，没有形成统一规则或项目。","channel":"in_person","evidence":"原八人横向专业关系继续加厚。"},

    {"event_id":"2031q4:e13","kind":"social_interaction","at":"2031-12-27","event_kind":"year_end_group_call","speaker":"lin_jing","listener":"he_xin","act":"share_experience","content":"林静说自己第一年没有买房也没有后悔搬去区域高校城市，现阶段最重要的是确认时间结构能否持续；何欣说自己也继续租住，两人的城市锁定仍主要来自工作和生活网络。","channel":"video_call","evidence":"住房未购买的城市锁定继续存在。"},
    {"event_id":"2031q4:e14","kind":"social_interaction","at":"2031-12-27","event_kind":"year_end_group_call","speaker":"zhou_ye","listener":"gao_yuan","act":"share_experience","content":"周野说今年最意外的是自己有一点买房能力却主动没买；高原听完只说自己目前连购房窗口都不急着开，家乡低租金已经满足当前生活。","channel":"video_call","evidence":"不同住房状态主动披露。"},
    {"event_id":"2031q4:e15","kind":"social_interaction","at":"2031-12-27","event_kind":"year_end_group_call","speaker":"song_nan","listener":"tang_yu","act":"check_in","content":"宋楠说自己明年会认真看一次外部市场但还没决定投；唐雨只说论文还在审，没有把两个人的等待和再评价说成谁更顺。","channel":"video_call","evidence":"开放线程只披露当前状态。"}
