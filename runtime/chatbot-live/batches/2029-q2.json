  "events": [
    {"event_id":"2029q2:e01","kind":"social_interaction","at":"2029-04-20","event_kind":"doctoral_completion_check","speaker":"lin_jing","listener":"shen_yan","act":"share_experience","content":"林静把博士阶段剩余材料按必须闭环的问题、可延后问题和以后独立发展的题目重新分开，核心材料已经能进入内部完成检查。","channel":"in_person","evidence":"由博士完成进度事件触发。"},
    {"event_id":"2029q2:e02","kind":"social_interaction","at":"2029-04-20","event_kind":"doctoral_completion_check","speaker":"shen_yan","listener":"lin_jing","act":"offer_information","content":"沈雁要求她不要为了毕业把所有未来题目都塞进当前论文，只把能形成完整论证闭环的部分留下；城市和职业选择等通过程序后再算。","channel":"in_person","evidence":"导师只处理学术完成边界。"},
    {"event_id":"2029q2:e03","kind":"social_interaction","at":"2029-04-20","event_kind":"doctoral_completion_check","speaker":"lin_jing","listener":"shen_yan","act":"make_plan","content":"林静决定进入正式完成流程，同时保留一条独立研究问题到毕业后再判断，不把博士论文变成无限扩张项目。","channel":"in_person","evidence":"形成博士完成候选。"},

    {"event_id":"2029q2:e04","kind":"actor_state_interaction","at":"2029-04-27","event_kind":"work_design_experiment","speaker":"he_xin","listener":"self_record","act":"share_experience","content":"何欣连续数周固定保住两块学习时间，并接到一个比常规流程稍复杂但仍在权限内的整理任务；她发现工作并非完全没有变化空间，只是需要主动守住时间。","channel":"private_record","evidence":"Q1工作实验经过实际时间和任务可用性检查。"},
    {"event_id":"2029q2:e05","kind":"actor_state_interaction","at":"2029-04-27","event_kind":"work_design_experiment","speaker":"he_xin","listener":"self_record","act":"make_plan","content":"何欣决定暂不考虑离开，先观察这种学习和任务变化能否稳定维持半年。","channel":"private_record","evidence":"轻度不满没有自动触发退出。"},

    {"event_id":"2029q2:e06","kind":"social_interaction","at":"2029-05-24","event_kind":"formal_role_interview_debrief","speaker":"chen_lan","listener":"wu_cheng","act":"share_experience","content":"陈岚说这次面试第一次把并行任务数、临时响应来源和优先级机制都问清楚：岗位收入不算最高，但主要任务更集中，临时响应有明确负责人轮转。","channel":"in_person","evidence":"由真实结构化面试生成岗位信息。"},
    {"event_id":"2029q2:e07","kind":"social_interaction","at":"2029-05-24","event_kind":"formal_role_interview_debrief","speaker":"wu_cheng","listener":"chen_lan","act":"offer_information","content":"吴澄提醒她别因为终于碰到结构更合适的岗位就提前接受；要等正式条件出来，再把住房、现金和职责一起算。","channel":"in_person","evidence":"无推荐资源。"},

    {"event_id":"2029q2:e08","kind":"social_interaction","at":"2029-05-31","event_kind":"verification_identity_checkin","speaker":"xu_hang","listener":"gu_wei","act":"share_experience","content":"许航把过去两年的贡献日志整理后发现，自己最稳定的价值不是修代码，而是能设计检查、冻结反例、区分实现脆弱性和结构风险；他想把这套方法独立写成组内验证规范。","channel":"in_person","evidence":"来自既有验证贡献日志。"},
    {"event_id":"2029q2:e09","kind":"social_interaction","at":"2029-05-31","event_kind":"verification_identity_checkin","speaker":"gu_wei","listener":"xu_hang","act":"offer_information","content":"顾维支持他先写内部规范，但要求每一条规则都对应真实失败案例或检查需求，避免把经验整理成空泛最佳实践。","channel":"in_person","evidence":"形成内部验证规范候选，不等于论文。"},

    {"event_id":"2029q2:e10","kind":"social_interaction","at":"2029-06-07","event_kind":"first_year_role_review","speaker":"luo_cheng","listener":"sun_jie","act":"share_experience","content":"罗诚说研究支持岗第一年最满意的地方是博士训练终于能用于理解研究材料和流程，但他也发现大量价值来自催节点、补文档和让不同角色说清同一件事。","channel":"wechat_private","evidence":"由第一年角色评估生成。"},
    {"event_id":"2029q2:e11","kind":"social_interaction","at":"2029-06-07","event_kind":"first_year_role_review","speaker":"sun_jie","listener":"luo_cheng","act":"repair","content":"孙洁说这和学生事务其实共享一部分底层能力，只是对象和内容不同；罗诚不需要把当年辅导员落选理解成博士训练没有价值。","channel":"wechat_private","evidence":"职业认知修正，不生成资源。"},

    {"event_id":"2029q2:e12","kind":"social_interaction","at":"2029-06-16","event_kind":"research_revision_check","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"唐雨把原来一个条件拆成机制条件和技术控制条件后，证明主线仍能走通，但反例只真正针对机制条件；她让许航重新检查反例是否仍跨实现稳定。","channel":"in_person","evidence":"Q1研究修订后的实际检查。"},
    {"event_id":"2029q2:e13","kind":"social_interaction","at":"2029-06-16","event_kind":"research_revision_check","speaker":"xu_hang","listener":"tang_yu","act":"offer_information","content":"许航确认反例在冻结的两套实现中仍出现，但提醒这只能支持机制条件的必要性线索；技术控制条件是否能弱化仍要单独处理。","channel":"in_person","evidence":"验证范围清楚。"},
    {"event_id":"2029q2:e14","kind":"social_interaction","at":"2029-06-16","event_kind":"research_revision_check","speaker":"tang_yu","listener":"xu_hang","act":"make_plan","content":"唐雨决定正式开始结构化写作草稿，但把技术控制条件的弱化列为未解决问题，不把内部草稿当成投稿完成。","channel":"in_person","evidence":"写作候选由修订和复核后产生。"},

    {"event_id":"2029q2:e15","kind":"social_interaction","at":"2029-06-23","event_kind":"first_job_half_year_review","speaker":"gao_yuan","listener":"lin_jing","act":"share_experience","content":"高原说半年后他仍喜欢低通勤和离家近，但开始真实感到学习资源和岗位横向流动比大城市少；目前这个代价仍在他可接受范围。","channel":"video_call","evidence":"低机会密度经过半年实际体验后进入判断。"},
    {"event_id":"2029q2:e16","kind":"social_interaction","at":"2029-06-23","event_kind":"first_job_half_year_review","speaker":"lin_jing","listener":"gao_yuan","act":"offer_information","content":"林静建议他把‘接受’写成当前状态，而不是以后每次不满都拿当初选择惩罚自己；如果未来代价变大，再按新状态重新评估。","channel":"video_call","evidence":"通用可逆性框架。"}
