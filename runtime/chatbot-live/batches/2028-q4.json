  "events": [
    {"event_id":"2028q4:e01","kind":"social_interaction","at":"2028-10-04","event_kind":"offer_bundle_evaluation","speaker":"chen_lan","listener":"lin_jing","act":"share_experience","content":"陈岚说正式岗位给出的收入和学习内容都够用，但面试确认的高频响应、多项目切换和北京住房成本叠在一起，几乎正好踩中她毕业后写下的时间边界。","channel":"in_person","evidence":"offer bundle通过面试信息和现有城市prior形成。"},
    {"event_id":"2028q4:e02","kind":"social_interaction","at":"2028-10-04","event_kind":"offer_bundle_evaluation","speaker":"lin_jing","listener":"chen_lan","act":"offer_information","content":"林静提醒她之前给自己写底线的意义就是在真正有offer时还能拒绝，而不是只有没选择时才讲边界。","channel":"in_person","evidence":"延续职业底线。"},
    {"event_id":"2028q4:e03","kind":"social_interaction","at":"2028-10-04","event_kind":"offer_bundle_evaluation","speaker":"chen_lan","listener":"lin_jing","act":"make_plan","content":"陈岚决定拒绝这份offer，继续寻找收入略低也可以、但响应边界更可持续的正式角色；她接受短期收入不确定性会延长。","channel":"in_person","evidence":"bundle不匹配导致主动拒绝。"},

    {"event_id":"2028q4:e04","kind":"social_interaction","at":"2028-10-14","event_kind":"offer_bundle_evaluation","speaker":"gao_yuan","listener":"lin_jing","act":"share_experience","content":"高原第二轮终于拿到家乡地级市公务员offer：工资和机会密度都不高，但住房压力、通勤、离父母距离和安全感几乎完全符合他最初的偏好。","channel":"video_call","evidence":"offer由公开考试第二轮产生。"},
    {"event_id":"2028q4:e05","kind":"social_interaction","at":"2028-10-14","event_kind":"offer_bundle_evaluation","speaker":"lin_jing","listener":"gao_yuan","act":"offer_information","content":"林静让他最后再确认一次：接受低机会密度不是错误，只要这是他明确愿意付的代价，而不是因为两年备考让他觉得必须接受任何结果。","channel":"video_call","evidence":"沉没成本检查。"},
    {"event_id":"2028q4:e06","kind":"social_interaction","at":"2028-10-14","event_kind":"offer_bundle_evaluation","speaker":"gao_yuan","listener":"lin_jing","act":"make_plan","content":"高原决定接受，理由是家庭距离、住房和稳定性确实长期重要；同时承认以后若成长空间成为主要矛盾，也要允许自己重新评估。","channel":"video_call","evidence":"bundle评估后接受。"},

    {"event_id":"2028q4:e07","kind":"social_interaction","at":"2028-10-25","event_kind":"postdegree_mentor_checkin","speaker":"wu_cheng","listener":"chen_lan","act":"share_experience","content":"吴澄说自己这一年也开始限制新增的非正式指导和项目承诺，因为团队里可靠的人总容易被默认承担更多收尾工作。","channel":"in_person","evidence":"吴澄自己的导师/团队管理线。"},
    {"event_id":"2028q4:e08","kind":"social_interaction","at":"2028-10-25","event_kind":"postdegree_mentor_checkin","speaker":"chen_lan","listener":"wu_cheng","act":"repair","content":"陈岚笑说自己毕业前几年正是这种‘可靠的人多接一点’的典型受害者，两人第一次把这个问题当作组织结构而不只是个人时间管理。","channel":"in_person","evidence":"共同经验反思，不生成资源。"},

    {"event_id":"2028q4:e09","kind":"social_interaction","at":"2028-11-03","event_kind":"distributed_classmate_call","speaker":"gao_yuan","listener":"zhou_ye","act":"share_experience","content":"高原告诉两位同学自己准备回家乡入职；他说两年考试最后换来的主要不是‘上岸’这个词，而是终于把自己愿意牺牲什么弄清楚。","channel":"video_call","evidence":"本人主动披露接受offer。"},
    {"event_id":"2028q4:e10","kind":"social_interaction","at":"2028-11-03","event_kind":"distributed_classmate_call","speaker":"luo_cheng","listener":"gao_yuan","act":"check_in","content":"罗诚说自己入职几个月后发现研究支持岗虽然工资一般，但比学生事务岗位更能用到博士训练；三个人的路线已经明显分开。","channel":"video_call","evidence":"第一份工作体验。"},
    {"event_id":"2028q4:e11","kind":"social_interaction","at":"2028-11-03","event_kind":"distributed_classmate_call","speaker":"zhou_ye","listener":"gao_yuan","act":"small_talk","content":"周野更多问他回去后租房还是住家里、通勤多久，没有把这次通话变成职业比较排名。","channel":"video_call","evidence":"普通生活互动。"},

    {"event_id":"2028q4:e12","kind":"social_interaction","at":"2028-11-15","event_kind":"research_condition_checkin","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"唐雨找到一个去掉额外条件后会破坏关键步骤的反例，因此现在更倾向认为该条件至少与机制有关，而不只是证明技巧；窄命题在保留条件时的证明草稿基本闭合。","channel":"in_person","evidence":"研究进展仍需独立核验，不直接记为发表结果。"},
    {"event_id":"2028q4:e13","kind":"social_interaction","at":"2028-11-15","event_kind":"research_condition_checkin","speaker":"shen_yan","listener":"tang_yu","act":"offer_information","content":"沈雁要求她把‘条件必要’和‘这个反例说明现有证明离不开条件’区分清楚，并安排下一步先做内部审读而非立刻写投稿叙事。","channel":"in_person","evidence":"防止过度解释。"},

    {"event_id":"2028q4:e14","kind":"social_interaction","at":"2028-11-23","event_kind":"verification_counterexample_check","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"唐雨把新反例交给许航复查实现，许航确认在两种实现下都能复现，但明确这只能支持反例本身可复现，不能替代理论必要性证明。","channel":"in_person","evidence":"验证贡献重新进入但范围受限。"},
    {"event_id":"2028q4:e15","kind":"social_interaction","at":"2028-11-23","event_kind":"verification_counterexample_check","speaker":"xu_hang","listener":"tang_yu","act":"offer_information","content":"许航把复现步骤和失败条件写进贡献日志，并建议如果进入写作阶段再按实际理论和验证贡献讨论署名。","channel":"in_person","evidence":"不预设作者关系。"},

    {"event_id":"2028q4:e16","kind":"social_interaction","at":"2028-12-01","event_kind":"same_city_weak_tie_meetup","speaker":"he_xin","listener":"zhou_ye","act":"check_in","content":"两人第二次同城见面只聊了工作满一年后最想保留和最想改变的部分；何欣想保留时间稳定，周野想保留技术交接和相对可预测的生活。","channel":"in_person","evidence":"弱联系通过第二次实际共同经历继续存在。"},
    {"event_id":"2028q4:e17","kind":"social_interaction","at":"2028-12-01","event_kind":"same_city_weak_tie_meetup","speaker":"zhou_ye","listener":"he_xin","act":"share_experience","content":"周野说自己暂时不会因为组织流程慢就换工作，他想先看第二年能否得到更完整的技术责任；何欣也说重复程序还没到让她离开的程度。","channel":"in_person","evidence":"不把轻度不满自动升级为跳槽。"},

    {"event_id":"2028q4:e18","kind":"social_interaction","at":"2028-12-09","event_kind":"first_year_industry_review","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠说第一年下来，她确认自己愿意继续留在医药统计至少一个阶段：收入和学习密度足够，但住房贵、离家远和组织流程重都是真实代价。","channel":"video_call","evidence":"第一年工作评估。"},
    {"event_id":"2028q4:e19","kind":"social_interaction","at":"2028-12-09","event_kind":"first_year_industry_review","speaker":"chen_lan","listener":"song_nan","act":"repair","content":"陈岚说‘愿意再待一年’已经是很具体的判断，不需要把第一份工作包装成人生归宿；宋楠也同意继续按能力增长而不是公司光环评估。","channel":"video_call","evidence":"职业期限化判断。"},

    {"event_id":"2028q4:e20","kind":"social_interaction","at":"2028-12-22","event_kind":"year_end_group_call","speaker":"gao_yuan","listener":"luo_cheng","act":"share_experience","content":"高原在群里公开说年后会回家乡入职，罗诚则说自己在区域高校研究支持岗已经做了半学期；两人都没有把路径说成标准答案。","channel":"video_call","evidence":"本人选择公开一般职业状态。"},
    {"event_id":"2028q4:e21","kind":"social_interaction","at":"2028-12-22","event_kind":"year_end_group_call","speaker":"chen_lan","listener":"lin_jing","act":"share_experience","content":"陈岚只说自己拒了一份边界不合适的正式offer、还在找；林静没有追问具体薪资和公司。","channel":"video_call","evidence":"本人选择有限披露。"},
    {"event_id":"2028q4:e22","kind":"social_interaction","at":"2028-12-22","event_kind":"year_end_group_call","speaker":"tang_yu","listener":"xu_hang","act":"check_in","content":"唐雨和许航只确认反例复查已经结束，接下来主要是理论内部审读，没有在群里讲未验证的研究细节。","channel":"video_call","evidence":"研究信息边界。"},
