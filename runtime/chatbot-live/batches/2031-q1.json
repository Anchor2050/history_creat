  "events": [
    {"event_id":"2031q1:e01","kind":"social_interaction","at":"2031-01-10","event_kind":"employment_relocation_and_first_job_transition","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静搬到区域高校城市后先租房，没有因为接受高校岗位就同时做长期住房承诺。入职第一周她最明显的感受是日程比博士阶段更碎：研究时间仍在，但会议、课程准备和行政流程开始占据固定块。","channel":"video_call","evidence":"租住与入职均已完成；只记录早期现实，不推断长期结果。"},
    {"event_id":"2031q1:e02","kind":"social_interaction","at":"2031-01-10","event_kind":"employment_relocation_and_first_job_transition","speaker":"chen_lan","listener":"lin_jing","act":"offer_information","content":"陈岚提醒她把合同里承诺的研究自主性和每天实际能拿到的连续时间分开记录，半年后再比较，不要用第一周的兴奋或疲惫替代判断。","channel":"video_call","evidence":"延续陈岚自己的时间边界经验。"},
    {"event_id":"2031q1:e03","kind":"social_interaction","at":"2031-01-18","event_kind":"employment_relocation_and_first_job_transition","speaker":"lin_jing","listener":"chen_lan","act":"make_plan","content":"林静决定前三个月只记录研究连续时间、服务工作和住房通勤，不立刻判断这份高校工作是否适合长期留下。","channel":"video_call","evidence":"第一年现实检查计划。"},

    {"event_id":"2031q1:e04","kind":"social_interaction","at":"2031-01-28","event_kind":"formal_role_identity_checkin","speaker":"chen_lan","listener":"wu_cheng","act":"share_experience","content":"陈岚进入正式岗位第二年后发现，自己越来越熟悉组织的数据流程和决策节奏，工作也更顺，但真正主动提出研究问题的时间比博士阶段少得多。","channel":"in_person","evidence":"岗位可持续与研究自由交换继续存在。"},
    {"event_id":"2031q1:e05","kind":"social_interaction","at":"2031-01-28","event_kind":"formal_role_identity_checkin","speaker":"wu_cheng","listener":"chen_lan","act":"check_in","content":"吴澄问她现在是否还需要用‘研究者’这个词维持自我解释；陈岚说她更想保留判断问题的能力，不急着保留原来的身份标签。","channel":"in_person","evidence":"身份变化来自两年实际工作，不产生职业转移。"},

    {"event_id":"2031q1:e06","kind":"social_interaction","at":"2031-02-08","event_kind":"industry_year_four_checkin","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠第四年仍愿意留在医药统计，但高住房成本和离家远已经从抽象缺点变成每年都要重新算的固定成本；她的便携案例档案让她知道自己即便未来离开，也不至于只能用公司名字解释能力。","channel":"video_call","evidence":"便携案例已经完成，当前无外部求职事实。"},
    {"event_id":"2031q1:e07","kind":"social_interaction","at":"2031-02-08","event_kind":"industry_year_four_checkin","speaker":"chen_lan","listener":"song_nan","act":"repair","content":"陈岚提醒她‘有能力离开’和‘现在应该离开’仍是两件事；宋楠把今年的判断继续放在学习密度是否下降，而不是只看成本升高。","channel":"video_call","evidence":"可逆性不自动触发跳槽。"},

    {"event_id":"2031q1:e08","kind":"social_interaction","at":"2031-02-19","event_kind":"old_classmate_growth_call","speaker":"gao_yuan","listener":"luo_cheng","act":"share_experience","content":"高原第三年工作越来越熟练，稳定感更强，但新问题变少；他第一次把‘我是不是只是越来越会做同一套流程’写进年度复盘。","channel":"phone","evidence":"第三年角色评估显示成长密度仍低。"},
    {"event_id":"2031q1:e09","kind":"social_interaction","at":"2031-02-19","event_kind":"old_classmate_growth_call","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚说自己这边研究支持工作反而慢慢增加了问题判断，但城市和岗位层级的上升空间仍有限；两人都没有因此立刻打开求职。","channel":"phone","evidence":"比较不同锁定结构，不生成求职候选。"},

    {"event_id":"2031q1:e10","kind":"social_interaction","at":"2031-03-06","event_kind":"home_purchase_consideration","speaker":"zhou_ye","listener":"chen_lan","act":"share_experience","content":"周野把省会购房工程测算给陈岚看：按现有工资、租金和生活先验，他勉强能够付首付后保留基本缓冲，但这会明显降低未来两三年的迁移弹性。","channel":"wechat_private","evidence":"2031住房检查在无新增照护成本假设下现金条件接近可行。"},
    {"event_id":"2031q1:e11","kind":"social_interaction","at":"2031-03-06","event_kind":"home_purchase_consideration","speaker":"chen_lan","listener":"zhou_ye","act":"offer_information","content":"陈岚问他最关键的问题不是‘买得起吗’，而是‘你已经愿意把未来几年绑定在这座城市了吗’；周野承认自己对岗位比第一年满意，但还没到愿意用住房锁住技术流动性的程度。","channel":"wechat_private","evidence":"稳定岗位没有自动转成长期城市承诺。"},
    {"event_id":"2031q1:e12","kind":"social_interaction","at":"2031-03-06","event_kind":"home_purchase_consideration","speaker":"zhou_ye","listener":"chen_lan","act":"make_plan","content":"周野决定2031这一轮不买，保留租住和现金缓冲，等2033窗口再看技术责任、家庭距离和城市留任意愿是否仍一致。","channel":"wechat_private","evidence":"财务可行但承诺检查不通过，主动延期而非购买失败。"},

    {"event_id":"2031q1:e13","kind":"social_interaction","at":"2031-03-08","event_kind":"home_purchase_consideration","speaker":"he_xin","listener":"lin_jing","act":"share_experience","content":"何欣算完后发现自己的现金缓冲远不到‘付首付后还能留足应急资金’的程度；她反而有点轻松，因为这次不需要把购房包装成价值观选择，现实条件已经先给出答案。","channel":"video_call","evidence":"2031住房工程检查触发hard cash block。"},
    {"event_id":"2031q1:e14","kind":"social_interaction","at":"2031-03-08","event_kind":"home_purchase_consideration","speaker":"lin_jing","listener":"he_xin","act":"repair","content":"林静说继续租房本身也是一个有效状态，尤其何欣现在已经清楚记录路径依赖；没有必要为了证明自己稳定，就再增加一个财务锁定。","channel":"video_call","evidence":"住房结果不与职业成功绑定。"},

    {"event_id":"2031q1:e15","kind":"actor_state_interaction","at":"2031-03-16","event_kind":"coordinator_boundary_scene","speaker":"sun_jie","listener":"self_record","act":"share_experience","content":"孙洁记录到统一队列已经减少熟人插队，但也让她在少数真正紧急的例外上更需要解释为什么这次可以越过普通顺序；边界制度化并没有消灭判断，只把判断集中到例外。","channel":"private_record","evidence":"延续正式队列边界的二阶效果。"},
    {"event_id":"2031q1:e16","kind":"actor_state_interaction","at":"2031-03-24","event_kind":"project_manager_intake_scene","speaker":"zhao_ke","listener":"self_record","act":"share_experience","content":"赵珂发现团队已经开始主动把部分模糊需求在进入他这里之前先补齐范围和责任人；他的个人解释成本下降了一点，但新问题变成了怎样让这套入口规则不过度僵化。","channel":"private_record","evidence":"项目入口边界从个人习惯逐渐变成团队流程。"}
