  "events":[
    {"event_id":"2034q4:e01","kind":"social_interaction","at":"2034-10-20","event_kind":"selective_external_interview","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚面试后确认岗位真实主责确实是研究运营设计、材料链路和方法支持，不是把流程协调换个名字；平台资源也明显高于现单位，但省会生活成本更高。","channel":"phone","evidence":"双门槛在面试层面继续成立。"},
    {"event_id":"2034q4:e02","kind":"social_interaction","at":"2034-10-20","event_kind":"selective_external_interview","speaker":"gao_yuan","listener":"luo_cheng","act":"check_in","content":"高原说如果最后有offer，罗诚这次至少是在为真正不同的工作内容付迁移成本；他自己仍没有因此降低门槛。","channel":"phone","evidence":"同伴面试不触发模仿。"},

    {"event_id":"2034q4:e03","kind":"social_interaction","at":"2034-11-10","event_kind":"midcareer_offer_bundle_evaluation","speaker":"luo_cheng","listener":"lin_jing","act":"share_experience","content":"罗诚拿到省会offer后把内容、平台、工资、住房和通勤重新算了一遍：工作内容和平台明显更好，生活成本上升但现金仍可承受，离家距离没有恶化到硬阻断。","channel":"video_call","evidence":"offer来自公开流程并进入完整bundle评估。"},
    {"event_id":"2034q4:e04","kind":"social_interaction","at":"2034-11-10","event_kind":"midcareer_offer_bundle_evaluation","speaker":"lin_jing","listener":"luo_cheng","act":"offer_information","content":"林静提醒他别把‘等了这么多年终于有一个’当接受理由，只看现在这份工作是否真的同时改善他一直坚持的两个门槛。","channel":"video_call","evidence":"防止等待时间成为沉没成本。"},
    {"event_id":"2034q4:e05","kind":"social_interaction","at":"2034-11-10","event_kind":"midcareer_offer_bundle_evaluation","speaker":"luo_cheng","listener":"lin_jing","act":"make_plan","content":"罗诚决定接受省会研究运营岗位，计划2035年初搬迁；他把它记成第一次真正同时改善内容和平台的机会，不写成早年辅导员目标的补偿。","channel":"video_call","evidence":"bundle与长期双门槛均通过。"},

    {"event_id":"2034q4:e06","kind":"social_interaction","at":"2034-11-18","event_kind":"research_project_gate_result","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"唐雨终于写出一个很小的可证伪陈述，并列了三类会让它失败的结构情形；它和上一项机制边界工作有方法论亲缘，但问题本身来自这两年反复回来的新疑问。","channel":"in_person","evidence":"项目门槛来自问题自身而非产出焦虑。"},
    {"event_id":"2034q4:e07","kind":"social_interaction","at":"2034-11-18","event_kind":"research_project_gate_result","speaker":"shen_yan","listener":"tang_yu","act":"make_plan","content":"沈雁同意2035开一个小项目，只做这一个最小陈述和反例边界；没有扩成系列论文，也不预设会成功。","channel":"in_person","evidence":"研究空档自然结束于一个有边界的小项目。"},

    {"event_id":"2034q4:e08","kind":"social_interaction","at":"2034-11-30","event_kind":"role_value_yearend_review","speaker":"he_xin","listener":"sun_jie","act":"share_experience","content":"何欣年底承认小任务确实让岗位重新出现一点学习感，但不是根本变化；她愿意留到2035再看一次住房，因为现在至少能说工作除了稳定还提供了有限的新判断。","channel":"wechat_private","evidence":"内部丰富部分修复岗位价值，不关闭未来退出。"},
    {"event_id":"2034q4:e09","kind":"social_interaction","at":"2034-11-30","event_kind":"role_value_yearend_review","speaker":"sun_jie","listener":"he_xin","act":"offer_information","content":"孙洁提醒她2035住房窗口要重新同时看现金、工作价值和城市承诺，不能因为这次内部任务有效就把未来七八年都算进去。","channel":"wechat_private","evidence":"住房仍独立复核。"},

    {"event_id":"2034q4:e10","kind":"social_interaction","at":"2034-12-05","event_kind":"second_role_year_two_review","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠第二年判断责任比第一年更完整，学习斜率仍只是中等，但生活成本和家庭距离改善持续；她没有重新打开求职。","channel":"video_call","evidence":"mixed bundle进入第二年仍稳定。"},
    {"event_id":"2034q4:e11","kind":"social_interaction","at":"2034-12-05","event_kind":"second_role_year_two_review","speaker":"chen_lan","listener":"song_nan","act":"check_in","content":"陈岚问她现在有没有觉得当年降薪是一种退步；宋楠说已经不太用那套单指标比较了，但仍会记录机会密度和学习速度作为真实成本。","channel":"video_call","evidence":"bundle解释稳定但成本未被抹掉。"},

    {"event_id":"2034q4:e12","kind":"social_interaction","at":"2034-12-08","event_kind":"combined_lockin_yearend_review","speaker":"zhou_ye","listener":"xu_hang","act":"share_experience","content":"周野年底发现第二判断者已经能独立接住一类常见复杂异常，自己的单点风险下降了一点；房贷和房产仍让换城更贵，但至少职业依赖没有和资产依赖一起继续恶化。","channel":"wechat_private","evidence":"二阶治理部分成功。"},
    {"event_id":"2034q4:e13","kind":"social_interaction","at":"2034-12-08","event_kind":"combined_lockin_yearend_review","speaker":"xu_hang","listener":"zhou_ye","act":"offer_information","content":"许航说这说明锁定并不只有‘留下或离开’两个答案，能不能把必须本人承担的部分变少，本身就是提高未来可逆性。","channel":"wechat_private","evidence":"治理锁定成为独立策略。"},

    {"event_id":"2034q4:e14","kind":"actor_state_interaction","at":"2034-12-15","event_kind":"mentor_capacity_personal_scene","speaker":"wu_cheng","listener":"self_record","act":"share_experience","content":"吴澄年底拒绝再接一个长期行政委员会，不是因为健康或家庭事件，而是发现自己真正愿意保留的稀缺时间已经从‘多指导几个学生’变成‘在少数复杂问题上还能认真判断’。","channel":"private_record","evidence":"职业阶段和时间偏好自身演化，不依赖新增六人。"},

    {"event_id":"2034q4:e15","kind":"social_interaction","at":"2034-12-26","event_kind":"year_end_group_call","speaker":"luo_cheng","listener":"gao_yuan","act":"share_experience","content":"罗诚告诉老同学自己年后要搬去省会，高原说自己仍留在家乡；两个人已经不再把移动和不移动当成谁更有出息，只各自继续给自己的交换记账。","channel":"video_call","evidence":"分化路线长期共存。"},
    {"event_id":"2034q4:e16","kind":"social_interaction","at":"2034-12-26","event_kind":"year_end_group_call","speaker":"tang_yu","listener":"lin_jing","act":"check_in","content":"唐雨说自己两年空档后终于有一个小问题愿意认真做，林静则说自己刚关掉一个做了两年的慢问题；两件事在同一通电话里没有被讲成坚持和放弃的对错。","channel":"video_call","evidence":"研究开启与关闭作为对称有效状态。"}
