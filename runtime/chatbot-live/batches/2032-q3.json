  "events": [
    {"event_id":"2032q3:e01","kind":"social_interaction","at":"2032-07-21","event_kind":"selective_interview_preparation","speaker":"luo_cheng","listener":"lin_jing","act":"share_experience","content":"罗诚收到面试后没有把重点放在‘怎样显得更厉害’，而是列出三个必须问清的问题：研究判断占比、流程协调占比、搬到省会后角色有没有真正更大平台。","channel":"video_call","evidence":"申请门槛是内容+平台双改善。"},
    {"event_id":"2032q3:e02","kind":"social_interaction","at":"2032-07-21","event_kind":"selective_interview_preparation","speaker":"lin_jing","listener":"luo_cheng","act":"offer_information","content":"林静提醒他面试也是获取bundle信息的机会，如果职责实际比招聘描述更偏行政协调，即使拿offer也可能不跨门槛。","channel":"video_call","evidence":"面试不只用于争取录用。"},

    {"event_id":"2032q3:e03","kind":"social_interaction","at":"2032-08-04","event_kind":"selective_interview_preparation","speaker":"song_nan","listener":"zhao_ke","act":"share_experience","content":"宋楠准备面试时把便携案例缩成三个判断片段：需求范围、版本变化和风险识别；她想借面试确认新岗位究竟是统计判断角色，还是主要做固定报表。","channel":"video_call","evidence":"外部申请门槛要求保留核心交付判断。"},
    {"event_id":"2032q3:e04","kind":"social_interaction","at":"2032-08-04","event_kind":"selective_interview_preparation","speaker":"zhao_ke","listener":"song_nan","act":"offer_information","content":"赵珂建议她尤其问清谁拥有需求定义权和异常解释权；如果岗位只是接需求做固定输出，离家近也不一定补得回学习损失。","channel":"video_call","evidence":"项目管理视角补充职责核验。"},

    {"event_id":"2032q3:e05","kind":"social_interaction","at":"2032-09-11","event_kind":"minor_revision_response","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"第二轮外审只剩minor revision，要求把一个边界表述再收紧，并在讨论里更明确写出验证框架不能推出什么。","channel":"video_call","evidence":"修回后外部质疑显著缩小但尚未接受。"},
    {"event_id":"2032q3:e06","kind":"social_interaction","at":"2032-09-11","event_kind":"minor_revision_response","speaker":"xu_hang","listener":"tang_yu","act":"make_plan","content":"许航直接在限制段加入一个负面例子，说明核心检查在某类问题上不能替代理论论证；两人决定只做这次要求范围内的修订。","channel":"video_call","evidence":"继续把验证边界写成主文责任。"},

    {"event_id":"2032q3:e07","kind":"social_interaction","at":"2032-09-17","event_kind":"technical_ownership_year_five_checkin","speaker":"zhou_ye","listener":"xu_hang","act":"share_experience","content":"周野第五年没有职位变化，但交接标准已经被多个团队日常使用；他个人收到的常规问题更少，复杂异常反而更集中。","channel":"wechat_private","evidence":"技术资产已经嵌入团队流程。"},
    {"event_id":"2032q3:e08","kind":"social_interaction","at":"2032-09-17","event_kind":"technical_ownership_year_five_checkin","speaker":"xu_hang","listener":"zhou_ye","act":"offer_information","content":"许航说这比头衔更能说明技术所有权已经发生变化，但也要记录复杂异常是不是越来越依赖周野个人，否则制度化只把简单工作移走。","channel":"wechat_private","evidence":"组织资产与专家单点风险并存。"},

    {"event_id":"2032q3:e09","kind":"social_interaction","at":"2032-09-22","event_kind":"public_institution_year_five_checkin","speaker":"he_xin","listener":"sun_jie","act":"share_experience","content":"何欣第五年现金缓冲比2031明显好，但岗位学习增长仍比较慢；她没有提前开启2033购房，只把现金改善和职业锁定分别记录。","channel":"wechat_private","evidence":"下一住房窗口尚未到，现金变化不自动触发购买。"},
    {"event_id":"2032q3:e10","kind":"social_interaction","at":"2032-09-22","event_kind":"public_institution_year_five_checkin","speaker":"sun_jie","listener":"he_xin","act":"offer_information","content":"孙洁提醒她明年购房再评价时先看城市承诺和退出成本有没有变化，不要因为这次终于‘买得起一点’就把过去的现金阻断补偿回来。","channel":"wechat_private","evidence":"2033住房判断提前定义但不执行。"},

    {"event_id":"2032q3:e11","kind":"social_interaction","at":"2032-08-18","event_kind":"university_role_second_year_midpoint","speaker":"lin_jing","listener":"chen_lan","act":"share_experience","content":"林静第二年中段仍能保住研究块，但她发现评价压力正把注意力从‘有没有时间’转到‘这段时间产出了什么’；自主性的下一层成本开始变成产出焦虑。","channel":"video_call","evidence":"时间边界稳定后出现绩效层压力。"},
