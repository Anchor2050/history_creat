  "events": [
    {"event_id":"2028q1:e01","kind":"social_interaction","at":"2028-01-12","event_kind":"first_job_checkin","speaker":"zhou_ye","listener":"gao_yuan","act":"share_experience","content":"周野说入职第一周最明显的变化是一天被会议、权限申请和交接切得比博士阶段碎，他以前整理复现包的习惯反而在接手旧流程时有用。","channel":"wechat_group","evidence":"由就业开始后的真实工作节奏生成；不披露单位敏感信息。"},
    {"event_id":"2028q1:e02","kind":"social_interaction","at":"2028-01-12","event_kind":"first_job_checkin","speaker":"gao_yuan","listener":"zhou_ye","act":"check_in","content":"高原问他稳定工作是否真的比博士轻松；周野说只是压力形状变了，至少下班时间更可预测一些，但组织流程比自己想象的慢。","channel":"wechat_group","evidence":"一般工作体验。"},
    {"event_id":"2028q1:e03","kind":"social_interaction","at":"2028-01-12","event_kind":"first_job_checkin","speaker":"luo_cheng","listener":"zhou_ye","act":"small_talk","content":"罗诚只问了租房和搬家有没有把人折腾坏，没有把这次群聊变成求职咨询。","channel":"wechat_group","evidence":"普通生活互动。"},

    {"event_id":"2028q1:e04","kind":"social_interaction","at":"2028-01-16","event_kind":"first_job_transition_chat","speaker":"he_xin","listener":"tang_yu","act":"share_experience","content":"何欣说新岗位真正让她安心的是任务边界比求职阶段清楚，但程序和文书比想象中多；省会住房还能承受，通勤开始变成每天都要算的时间成本。","channel":"wechat_group","evidence":"就业bundle转成日常体验。"},
    {"event_id":"2028q1:e05","kind":"social_interaction","at":"2028-01-16","event_kind":"first_job_transition_chat","speaker":"song_nan","listener":"tang_yu","act":"share_experience","content":"宋楠说医药岗位刚开始大量时间都在理解业务流程、数据权限和文档要求，真正能动手分析的时间比她想象中少，但她暂时把这看成学习成本。","channel":"wechat_group","evidence":"一般行业onboarding，不涉及公司敏感信息。"},
    {"event_id":"2028q1:e06","kind":"social_interaction","at":"2028-01-16","event_kind":"first_job_transition_chat","speaker":"tang_yu","listener":"he_xin","act":"check_in","content":"唐雨发现两位同学开始上班后回复明显变慢，三人约定不因为群里沉默就解释成关系变淡，有空再约。","channel":"wechat_group","evidence":"时间约束导致联系频率变化。"},

    {"event_id":"2028q1:e07","kind":"social_interaction","at":"2028-01-27","event_kind":"industry_onboarding_checkin","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠说自己以前练的项目语言现在真用上了，但也第一次碰到分析方案必须服从数据权限、版本控制和跨团队确认的情况，很多事情不能靠一个统计师单独决定。","channel":"video_call","evidence":"入职后的组织约束。"},
    {"event_id":"2028q1:e08","kind":"social_interaction","at":"2028-01-27","event_kind":"industry_onboarding_checkin","speaker":"chen_lan","listener":"song_nan","act":"offer_information","content":"陈岚提醒她先学会分辨哪些限制是合理协作成本、哪些只是组织低效；第一季度先记录，不急着用学术训练去证明自己比流程聪明。","channel":"video_call","evidence":"通用职业反馈。"},

    {"event_id":"2028q1:e09","kind":"social_interaction","at":"2028-02-10","event_kind":"post_degree_career_search","speaker":"chen_lan","listener":"lin_jing","act":"share_experience","content":"陈岚说博士完成以后，她反而更难接受‘先接着做再看’的模糊工作结构；她想找收入能覆盖生活、职责明确、又不要求长期无限响应的正式角色。","channel":"in_person","evidence":"延续毕业后职业约束。"},
    {"event_id":"2028q1:e10","kind":"social_interaction","at":"2028-02-10","event_kind":"post_degree_career_search","speaker":"lin_jing","listener":"chen_lan","act":"offer_information","content":"林静建议她把最低收入、最长可接受响应时间、是否能持续学习和城市住房四个底线先写出来，再看职位，不再只按‘机会看起来不错’排序。","channel":"in_person","evidence":"通用bundle框架。"},
    {"event_id":"2028q1:e11","kind":"social_interaction","at":"2028-02-10","event_kind":"post_degree_career_search","speaker":"chen_lan","listener":"lin_jing","act":"make_plan","content":"陈岚决定只进入满足基本边界的正式招聘或合同流程，不再把无明确范围的外部项目当长期职业候选。","channel":"in_person","evidence":"职业搜索规则收紧。"},

    {"event_id":"2028q1:e12","kind":"social_interaction","at":"2028-02-14","event_kind":"research_support_interview_prep","speaker":"luo_cheng","listener":"sun_jie","act":"share_experience","content":"罗诚说新的研究支持岗位终于允许他把博士训练、材料流程和协调经验放在同一个叙事里，他被邀请面试，但不确定自己是否会再次缺少直接岗位经验。","channel":"wechat_private","evidence":"公开申请进入面试。"},
    {"event_id":"2028q1:e13","kind":"social_interaction","at":"2028-02-14","event_kind":"research_support_interview_prep","speaker":"sun_jie","listener":"luo_cheng","act":"offer_information","content":"孙洁让他把前两次失败学到的边界直接说清：有些学生工作他没做过，但长期研究、材料整理、流程跟进和跨人沟通是做过的；不要再试图把自己包装成不存在的学生事务老手。","channel":"wechat_private","evidence":"事实型面试准备。"},

    {"event_id":"2028q1:e14","kind":"social_interaction","at":"2028-02-26","event_kind":"research_mechanism_checkin","speaker":"tang_yu","listener":"shen_yan","act":"share_experience","content":"唐雨尝试证明年末定下的最小机制命题，但一个过于一般的版本很快被自己找到反例推翻；她只保留了更窄的条件。","channel":"in_person","evidence":"研究失败通过内部验证产生，不写成成功定理。"},
    {"event_id":"2028q1:e15","kind":"social_interaction","at":"2028-02-26","event_kind":"research_mechanism_checkin","speaker":"shen_yan","listener":"tang_yu","act":"repair","content":"沈雁认为这次失败反而有用，因为它说明问题边界终于能被反例约束；下一步只研究剩下那个窄命题，不补更多方法。","channel":"in_person","evidence":"研究线通过失败收缩。"},

    {"event_id":"2028q1:e16","kind":"social_interaction","at":"2028-03-12","event_kind":"verification_identity_checkin","speaker":"xu_hang","listener":"gu_wei","act":"share_experience","content":"许航说自己最近开始把验证工作按‘风险识别—检查设计—结论变化’记录，而不是按帮谁跑了多少代码记录，他感觉这更接近自己的研究身份。","channel":"in_person","evidence":"延续贡献日志与独立判断框架。"},
    {"event_id":"2028q1:e17","kind":"social_interaction","at":"2028-03-12","event_kind":"verification_identity_checkin","speaker":"gu_wei","listener":"xu_hang","act":"offer_information","content":"顾维让他继续观察这种记录能否自然生出独立问题；如果永远只能附着在别人项目上，身份问题还没有真正解决。","channel":"in_person","evidence":"不预写独立成果。"},

    {"event_id":"2028q1:e18","kind":"social_interaction","at":"2028-03-23","event_kind":"project_gate_checkin","speaker":"zhao_ke","listener":"chen_lan","act":"share_experience","content":"赵珂说他把外部协作者接入点后移以后，前期少了很多含糊试工，但有些项目也因此更早暴露出预算和责任人根本没准备好。","channel":"wechat_private","evidence":"2027年项目管理边界的后果。"},
    {"event_id":"2028q1:e19","kind":"social_interaction","at":"2028-03-23","event_kind":"project_gate_checkin","speaker":"chen_lan","listener":"zhao_ke","act":"repair","content":"陈岚觉得这种早失败比后面无限返工便宜，她也更愿意只在范围明确以后进入合作。","channel":"wechat_private","evidence":"双方项目边界继续趋同。"}
  ],
