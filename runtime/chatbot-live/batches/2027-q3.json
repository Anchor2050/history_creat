  "events": [
    {"event_id":"2027q3:e01","kind":"social_interaction","at":"2027-07-09","event_kind":"recruitment_interview_debrief","speaker":"song_nan","listener":"chen_lan","act":"share_experience","content":"宋楠说第一轮真正难的不是方法题，而是对方不断改变业务条件后，她能不能及时说清哪些结论还成立、哪些需要重做。她进入了下一轮，但仍不知道最终结果。","channel":"wechat_private","evidence":"公开招聘流程产生下一轮邀请。"},
    {"event_id":"2027q3:e02","kind":"social_interaction","at":"2027-07-09","event_kind":"recruitment_interview_debrief","speaker":"chen_lan","listener":"song_nan","act":"offer_information","content":"陈岚提醒她第二轮继续把边界说清，不知道的就说明需要什么数据或时间才能判断；如果为了显得像行业人而什么都答，会把前一年练出的可靠性丢掉。","channel":"wechat_private","evidence":"一般职业反馈。"},

    {"event_id":"2027q3:e03","kind":"social_interaction","at":"2027-07-21","event_kind":"technical_screen_debrief","speaker":"zhou_ye","listener":"xu_hang","act":"share_experience","content":"周野说技术筛查里对方确实问了别人如何复跑、结果怎么核验和异常如何记录；他的复现包第一次直接成为解释工作方式的证据，因此进入最终面试。","channel":"wechat_private","evidence":"公开招聘技术筛查结果，不表示录用。"},
    {"event_id":"2027q3:e04","kind":"social_interaction","at":"2027-07-21","event_kind":"technical_screen_debrief","speaker":"xu_hang","listener":"zhou_ye","act":"repair","content":"许航说这只能说明样本和岗位当前需求有匹配，不代表复现包本身是什么万能通行证；最终面试还会重新评估岗位理解和协作方式。","channel":"wechat_private","evidence":"防止单一因果归因。"},

    {"event_id":"2027q3:e05","kind":"social_interaction","at":"2027-08-03","event_kind":"doctoral_defense","speaker":"chen_lan","listener":"wu_cheng","act":"share_experience","content":"正式答辩结束后，陈岚确认主要研究内容通过，但仍需按意见完成一轮小范围文本和规范修改，学位流程还没有完全结束。","channel":"in_person","evidence":"博士完成候选通过答辩环节但仍有后续程序。"},
    {"event_id":"2027q3:e06","kind":"social_interaction","at":"2027-08-03","event_kind":"doctoral_defense","speaker":"wu_cheng","listener":"chen_lan","act":"offer_information","content":"吴澄要求她把修改限定在答辩明确提出的范围，不借机重新扩展结果，并先把学位流程真正闭环再安排下一份长期工作。","channel":"in_person","evidence":"导师继续维持完成边界。"},

    {"event_id":"2027q3:e07","kind":"social_interaction","at":"2027-08-10","event_kind":"public_exam_result_debrief","speaker":"gao_yuan","listener":"lin_jing","act":"share_experience","content":"高原告诉林静这轮笔试没有进面试线。他有点失落，但至少已经完整跑过一次报名、准备和考试流程。","channel":"wechat_private","evidence":"公开考试结果。"},
    {"event_id":"2027q3:e08","kind":"social_interaction","at":"2027-08-10","event_kind":"public_exam_result_debrief","speaker":"lin_jing","listener":"gao_yuan","act":"offer_information","content":"林静建议他先拆结果：哪些是可改的知识与表达准备，哪些只是岗位竞争和分数线；如果还要再考，应该基于真实差距决定，而不是因为已经投入很多时间就机械继续。","channel":"wechat_private","evidence":"一般失败复盘框架。"},
    {"event_id":"2027q3:e09","kind":"social_interaction","at":"2027-08-10","event_kind":"public_exam_result_debrief","speaker":"gao_yuan","listener":"lin_jing","act":"make_plan","content":"高原决定保留公务员主线到下一周期，但给自己设一个复盘窗口：如果毕业和下一轮准备的时间冲突继续扩大，就必须重新评估是否增加其他稳定岗位选项。","channel":"wechat_private","evidence":"失败后维持主线但增加退出条件。"},

    {"event_id":"2027q3:e10","kind":"social_interaction","at":"2027-08-24","event_kind":"public_institution_interview_prep","speaker":"he_xin","listener":"sun_jie","act":"ask_advice","content":"何欣说自己通过了笔试，面试前最担心的是把岗位说得太理想化；她问孙洁怎样在不了解内部情况时回答对日常工作的理解。","channel":"wechat_private","evidence":"公开程序进入面试。"},
    {"event_id":"2027q3:e11","kind":"social_interaction","at":"2027-08-24","event_kind":"public_institution_interview_prep","speaker":"sun_jie","listener":"he_xin","act":"offer_information","content":"孙洁让她只基于岗位说明和自己真实经历回答：哪些职责她做过类似部分、哪些没做过、如果遇到不熟悉程序会怎样查规则和留下记录；不要假装知道单位内部运作。","channel":"wechat_private","evidence":"通用程序性准备，无内部信息。"},
    {"event_id":"2027q3:e12","kind":"social_interaction","at":"2027-08-24","event_kind":"public_institution_interview_prep","speaker":"sun_jie","listener":"he_xin","act":"set_boundary","content":"孙洁再次说明她不会替何欣打听面试题或内部评价，也不会因为认识就去影响流程。","channel":"wechat_private","evidence":"权限边界。"},

    {"event_id":"2027q3:e13","kind":"social_interaction","at":"2027-09-07","event_kind":"application_rejection_debrief","speaker":"luo_cheng","listener":"sun_jie","act":"share_experience","content":"罗诚说第二条学生事务岗位面试后也没有录用。他发现自己能讲清流程和跟进，但面对直接学生工作情境时例子仍然偏少。","channel":"in_person","evidence":"公开招聘拒绝。"},
    {"event_id":"2027q3:e14","kind":"social_interaction","at":"2027-09-07","event_kind":"application_rejection_debrief","speaker":"sun_jie","listener":"luo_cheng","act":"offer_information","content":"孙洁没有劝他继续死磕同类岗位，只让他把想要的工作元素拆出来：稳定、与人协作、流程责任、大学环境，这些元素未必只能由辅导员岗位同时提供。","channel":"in_person","evidence":"职业元素拆分，不指定新岗位。"},
    {"event_id":"2027q3:e15","kind":"social_interaction","at":"2027-09-07","event_kind":"application_rejection_debrief","speaker":"luo_cheng","listener":"sun_jie","act":"make_plan","content":"罗诚决定下一轮把高校行政、研究支持和公共机构中的流程协调类岗位也纳入比较，同时保留辅导员作为一个选项而不是唯一身份。","channel":"in_person","evidence":"第一次明确目标修订。"},

    {"event_id":"2027q3:e16","kind":"social_interaction","at":"2027-09-18","event_kind":"verification_followup","speaker":"tang_yu","listener":"xu_hang","act":"share_experience","content":"唐雨进一步检查后发现，一部分异常确实随实现变化消失，但另一部分在不同实现下仍反复出现。她开始能把实现问题和结构问题分开描述。","channel":"in_person","evidence":"验证链继续产生候选证据，不宣称理论完成。"},
    {"event_id":"2027q3:e17","kind":"social_interaction","at":"2027-09-18","event_kind":"verification_followup","speaker":"xu_hang","listener":"tang_yu","act":"offer_information","content":"许航建议她把稳定出现的部分冻结成一份可复现反例集，再由唐雨自己回到理论结构解释为什么会发生；验证工作先到这里，避免无限扩计算。","channel":"in_person","evidence":"限定验证贡献范围。"},
    {"event_id":"2027q3:e18","kind":"social_interaction","at":"2027-09-18","event_kind":"verification_followup","speaker":"tang_yu","listener":"xu_hang","act":"offer_help","content":"唐雨提出如果后面理论解释真正形成，她会按实际贡献重新讨论许航是否继续参与，而不是提前默认作者关系。","channel":"in_person","evidence":"贡献和署名保持开放。"},

    {"event_id":"2027q3:e19","kind":"social_interaction","at":"2027-09-29","event_kind":"alumni_methods_meetup","speaker":"song_nan","listener":"xu_hang","act":"share_experience","content":"宋楠选择公开说自己拿到一份医药统计岗位的条件offer，但还没有接受，因为城市、住房和职业机会要一起算。她没有公开薪资细节。","channel":"in_person","evidence":"offer事实由hard-world公开招聘结果生成；具体私人条款未广播。"},
    {"event_id":"2027q3:e20","kind":"social_interaction","at":"2027-09-29","event_kind":"alumni_methods_meetup","speaker":"zhou_ye","listener":"tang_yu","act":"share_experience","content":"周野说自己也拿到一份省会国企技术岗条件offer，稳定性比他最初想象的真实，但他现在反而更在意岗位内容、离家距离和以后还能不能继续做技术。","channel":"in_person","evidence":"offer由公开招聘生成；只公开一般选择维度。"},
    {"event_id":"2027q3:e21","kind":"social_interaction","at":"2027-09-29","event_kind":"alumni_methods_meetup","speaker":"tang_yu","listener":"zhou_ye","act":"check_in","content":"唐雨没有劝周野接受或拒绝，只问他复现包真正帮他争取到的是岗位本身，还是让他更清楚自己想做哪类工作；两人的弱联系仍停留在偶尔技术交流。","channel":"in_person","evidence":"无资源转移。"},
    {"event_id":"2027q3:e22","kind":"social_interaction","at":"2027-09-29","event_kind":"alumni_methods_meetup","speaker":"he_xin","listener":"lin_jing","act":"share_experience","content":"何欣只说自己已经参加完面试，结果未出；她仍保留之前的城市和退出成本比较表，没有因为进到后期就预先把岗位当成自己的。","channel":"in_person","evidence":"公开流程状态。"}
  ],
