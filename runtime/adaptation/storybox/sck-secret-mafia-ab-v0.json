{
  "schema_version": 1,
  "status": "designed_not_run",
  "purpose": "Test whether explicit belief and two-ply planning materially improve high-skill social-deduction play before SCK is used as a narrative decision component.",
  "environment": {
    "primary": "TextArena SecretMafia-v0",
    "source_reference": "TextArena/TextArena:textarena/envs/SecretMafia/env.py",
    "player_counts": [6, 8, 10],
    "discussion_rounds": 3,
    "seed_policy": "shared_seed_and_role_schedule_across_variants",
    "role_stratification": ["Villager", "Mafia", "Doctor", "Detective"]
  },
  "variants": [
    {
      "id": "plain",
      "memory": false,
      "belief": false,
      "planning_depth": 0,
      "communication_separated": false
    },
    {
      "id": "memory",
      "memory": true,
      "belief": false,
      "planning_depth": 0,
      "communication_separated": false
    },
    {
      "id": "belief",
      "memory": true,
      "belief": true,
      "planning_depth": 0,
      "communication_separated": true
    },
    {
      "id": "belief_planning",
      "memory": true,
      "belief": true,
      "planning_depth": 2,
      "communication_separated": true
    }
  ],
  "primary_metrics": [
    "win_rate",
    "per_role_win_rate",
    "mean_brier",
    "mean_action_regret",
    "information_leakage_count"
  ],
  "secondary_metrics": [
    "belief_shift_after_informative_evidence",
    "belief_resistance_to_noninformative_accusation",
    "claim_contradiction_count",
    "persuasion_delta",
    "strategy_diversity",
    "runtime_and_token_cost"
  ],
  "minimum_validity_conditions": [
    "All variants receive identical public/private observations for the same seed and role schedule.",
    "Backstage truth is available only to the evaluator, never to the decision policy.",
    "Discussion language generation is separated from strategic action in belief and belief_planning variants.",
    "Role-conditioned results are reported because aggregate win rate can hide role imbalance.",
    "A planning win claim requires lower action regret or higher win/utility without materially worse calibration/leakage, not merely more verbose reasoning."
  ],
  "first_milestone": {
    "episodes_per_variant": 50,
    "goal": "smoke-test effect direction and instrumentation",
    "not_for_final_claim": true
  },
  "second_milestone": {
    "episodes_per_variant": 500,
    "goal": "stable role-stratified comparison",
    "requires": [
      "fixed model version",
      "fixed prompts",
      "shared seeds",
      "cost logging",
      "failure replay retention"
    ]
  }
}
